# Release archives are attached to the GitHub Release, never committed.
/_release_assets/

# Python bytecode.
__pycache__/
*.py[cod]

# LaTeX build by-products (only under paper/: experiment logs elsewhere are kept).
/paper/**/*.aux
/paper/**/*.log
/paper/**/*.out
/paper/**/*.blg
/paper/**/*.synctex.gz
/paper/**/*.fls
/paper/**/*.fdb_latexmk

# Organisers' data: download it from the organisers (CC BY 4.0), do not commit it.
/development_files/
/test_questions/

# The response cache database comes from the release archive.
/cache/llm_cache.sqlite3*

# Run locks written by the code.
.*.lock
.*.holder
