            "code": "def solve():\n    eq = Q(930)\n    bd = Q(1680)\n    target = Q(\"0.45\")\n    c = Q(\"0.011\")\n    wd = Q(70)\n    # gross bond sale so net proceeds equal the withdrawal\n    g_w = wd / (1 - c)\n    W = eq + bd - g_w  # total after withdrawal (bond holding fell by g_w, cash left the account)\n    weight = eq / W\n    if weight > target:\n        # overweight: sell equity gross G, reinvest net in bonds\n        # equity after = eq - G = target*(W - c*G)\n        G = (eq - target * W) / (1 - target * c)\n        equity_trade = -G\n        total = W - c * G\n    elif weight < target:\n        # underweight: sell bonds gross G, buy equity with net proceeds\n        G = (target * W - eq) / ((1 - c) + target * c)\n        equity_trade = G * (1 - c)\n        total = W - c * G\n    else:\n        equity_trade = Q(0)\n        total = W\n    return {\n        \"final\": total,\n        \"withdrawal_gross_sale\": g_w,\n        \"post_withdrawal_weight\": weight * 100,\n        \"equity_trade\": equity_trade,\n    }\n",
