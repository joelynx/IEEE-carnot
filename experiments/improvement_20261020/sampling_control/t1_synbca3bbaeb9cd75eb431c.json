            "code": "def solve():\n    face = Q(2000)\n    y = Q(\"0.075\")\n    r1 = Q(\"6.5\") / 100\n    r2 = r1 + Q(-100) / 10000          # rate from year 2 onward (-100 bp)\n    days = Q(330)\n\n    # Year 1: coupon on full face, then 35% installment\n    out1 = face\n    inst1 = face * Q(\"0.35\")\n    cf1 = r1 * out1 + inst1\n\n    # Year 2: coupon on balance outstanding during year 2, then 40% installment\n    out2 = out1 - inst1\n    inst2 = face * Q(\"0.40\")\n    cf2_sched = r2 * out2 + inst2\n\n    # Principal remaining after year-2 installment\n    out3 = out2 - inst2\n\n    # Year-3 scheduled payment and its value at end of year 2\n    cf3 = r2 * out3 + out3\n    pv3_at2 = cf3 / (1 + y)\n\n    # Call iff call price strictly below PV of remaining payment\n    call_pay = Q(\"1.03\") * out3\n    called = call_pay < pv3_at2\n    decision = \"call\" if called else \"no_call\"\n\n    # Total cash received at end of year 2 (call payment added only if called)\n    cf2_total = cf2_sched + (call_pay if called else Q(0))\n\n    t = days / 360\n    def disc(k):\n        return (1 + y) ** (k - t)\n\n    price = cf1 / disc(1) + cf2_total / disc(2)\n    if not called:\n        price += cf3 / disc(3)\n\n    return {\n        \"final\": price,\n        \"principal_after_year2\": out3,\n        \"pv_year3_at_year2\": pv3_at2,\n        \"call_decision\": decision,\n        \"year2_total_received\": cf2_total,\n    }\n",
