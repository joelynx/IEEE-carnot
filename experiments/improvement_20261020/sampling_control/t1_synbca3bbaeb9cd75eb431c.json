            "code": "def solve():\n    face = Q(2000)\n    y = Q(\"0.075\")\n    t_settle = Q(330, 360)  # years elapsed at settlement\n\n    # Principal schedule\n    inst1 = face * Q(\"0.35\")\n    inst2 = face * Q(\"0.40\")\n    p0 = face\n    p1 = p0 - inst1          # outstanding during year 2\n    p2 = p1 - inst2          # outstanding during year 3 (after year-2 installment)\n    inst3 = p2\n\n    # Coupon rates\n    r1 = Q(\"0.065\")\n    r2 = r1 - Q(\"0.01\")      # year 2 onward: -100 bp\n    r3 = r2\n\n    cf1 = r1 * p0 + inst1\n    cf2 = r2 * p1 + inst2    # year-2 total scheduled payment\n    cf3 = r3 * p2 + inst3\n\n    # Value at end of year 2 of year-3 payment\n    pv3_at2 = cf3 / (1 + y)\n    call_payment = Q(\"1.03\") * p2\n    called = call_payment < pv3_at2\n    decision = \"call\" if called else \"no_call\"\n\n    def disc(k):\n        return (1 + y) ** (k - t_settle)\n\n    if called:\n        year2_total = cf2 + call_payment\n        price = cf1 / disc(1) + year2_total / disc(2)\n    else:\n        year2_total = cf2\n        price = cf1 / disc(1) + cf2 / disc(2) + cf3 / disc(3)\n\n    return {\n        \"final\": price,\n        \"principal_after_year2\": p2,\n        \"pv_year3_at_year2\": pv3_at2,\n        \"call_decision\": decision,\n        \"year2_total_received\": year2_total,\n    }\n",
