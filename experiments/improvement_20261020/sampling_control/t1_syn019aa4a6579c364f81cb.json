            "code": "def solve():\n    A = Q(1750)\n    D0 = Q(225)\n    shares = Q(40)\n    planned = Q(450)\n    fee_rate = Q(\"0.03\")\n    shield_rate = Q(\"0.26\")\n    cap = Q(\"0.8\")\n\n    # Equity after repurchase as a function of new debt N:\n    # A + shield*N - fee*N - (D0 + N)\n    def eq_after(N):\n        return A + shield_rate * N - fee_rate * N - D0 - N\n\n    # Check the covenant at the planned issue\n    if (D0 + planned) / eq_after(planned) <= cap:\n        N = planned\n    else:\n        # Solve (D0+N) = cap*(A + (shield-fee)*N - D0 - N) for N\n        k = shield_rate - fee_rate - 1\n        N = (cap * (A - D0) - D0) / (1 - cap * k)\n\n    fee = fee_rate * N\n    shield = shield_rate * N\n    net_proceeds = N - fee\n    total_debt = D0 + N\n\n    # Equity just after issue, with net proceeds still held as cash\n    equity_pre_repo = A + shield - fee + net_proceeds - total_debt\n    price = equity_pre_repo / shares\n\n    repurchased = net_proceeds / price\n    shares_after = shares - repurchased\n    equity_after = equity_pre_repo - net_proceeds\n\n    return {\n        \"final\": shares_after,\n        \"debt_issued\": N,\n        \"repurchase_price\": price,\n        \"equity_after\": equity_after,\n    }\n",
