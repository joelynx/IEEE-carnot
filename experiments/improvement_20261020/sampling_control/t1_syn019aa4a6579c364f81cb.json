            "code": "def solve():\n    V_U = Q(1750)          # unlevered asset value, USD million\n    D_old = Q(225)         # existing debt, no tax-shield value\n    shares0 = Q(40)        # original shares, millions\n    D_plan = Q(450)        # planned new debt\n    fee_rate = Q(\"0.03\")   # underwriting fee on amount issued\n    ts_rate = Q(\"0.26\")    # tax-shield value per dollar of new debt\n    cap = Q(\"0.8\")         # covenant: total debt / post-repurchase equity\n\n    def equity_post(x):\n        # unlevered value + tax shield - fee - total debt\n        return V_U + ts_rate * x - fee_rate * x - (D_old + x)\n\n    # Apply covenant cap if planned issue breaches it\n    if (D_old + D_plan) / equity_post(D_plan) > cap:\n        # (D_old + x) = cap * (V_U - D_old + (ts - fee - 1) x), solve linearly for x\n        x = (cap * (V_U - D_old) - D_old) / (1 - cap * (ts_rate - fee_rate - 1))\n        debt_issued = x\n    else:\n        debt_issued = D_plan\n\n    fee = fee_rate * debt_issued\n    net_proceeds = debt_issued - fee\n    tax_shield = ts_rate * debt_issued\n\n    # Equity just after issue, net proceeds still held as cash\n    equity_pre_buyback = V_U + tax_shield - fee + net_proceeds - (D_old + debt_issued)\n    price = equity_pre_buyback / shares0\n\n    shares_bought = net_proceeds / price\n    shares_after = shares0 - shares_bought\n\n    equity_after = equity_post(debt_issued)\n\n    return {\n        \"final\": shares_after,\n        \"debt_issued\": debt_issued,\n        \"repurchase_price\": price,\n        \"equity_after\": equity_after,\n    }\n",
