            "code": "def solve():\n    VU = Q(1750)          # unlevered asset value, USD million\n    D0 = Q(225)           # existing debt, no tax-shield value\n    n0 = Q(40)            # original shares, millions\n    planned = Q(450)      # planned new debt\n    fee_rate = Q(\"0.03\")\n    ts_rate = Q(\"0.26\")\n    cap = Q(\"0.8\")\n\n    def equity_post(N):\n        # post-repurchase equity = VU + tax shield - fee - total debt\n        return VU + ts_rate * N - fee_rate * N - (D0 + N)\n\n    N = planned\n    if (D0 + N) / equity_post(N) > cap:\n        # (D0+N) = cap*(VU - D0 + (ts - fee - 1)N), solved for N\n        N = (cap * (VU - D0) - D0) / (1 + cap * (1 - ts_rate + fee_rate))\n\n    fee = fee_rate * N\n    net_proceeds = N - fee\n    E_after = equity_post(N)\n    # equity just after issue, net proceeds still held as cash\n    E_before = E_after + net_proceeds\n    price = E_before / n0\n    shares_bought = net_proceeds / price\n    shares_after = n0 - shares_bought\n\n    return {\n        \"final\": shares_after,\n        \"debt_issued\": N,\n        \"repurchase_price\": price,\n        \"equity_after\": E_after,\n    }\n",
