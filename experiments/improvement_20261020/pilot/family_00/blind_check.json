                "code": "def solve():\n    cost = 65000\n    life = 6\n    annual_dep = cost / life  # 10833.33...\n\n    # End of year 2, after depreciation\n    carrying_y2 = cost - 2 * annual_dep\n    recoverable_y2 = cost * 0.33\n    impairment_loss = carrying_y2 - recoverable_y2  # positive loss magnitude\n\n    # Depreciate written-down amount over remaining 4 years\n    remaining_life = life - 2\n    new_dep = recoverable_y2 / remaining_life\n    carrying_pre_reversal = recoverable_y2 - new_dep  # end of year 3\n\n    # Ceiling: depreciated cost had no impairment occurred\n    reversal_ceiling = cost - 3 * annual_dep\n\n    recoverable_y3 = cost * 0.52\n    target = min(recoverable_y3, reversal_ceiling)\n    reversal_recognized = max(target - carrying_pre_reversal, 0)\n\n    carrying_post = carrying_pre_reversal + reversal_recognized\n    total_assets = carrying_post + 220000\n    total_liabilities = 290000\n    actual_ratio_pct = total_liabilities / total_assets * 100\n    cap_pct = 55\n    headroom = cap_pct - actual_ratio_pct  # negative if breached\n\n    return {\n        \"final\": headroom,\n        \"impairment_loss\": impairment_loss,\n        \"carrying_pre_reversal\": carrying_pre_reversal,\n        \"reversal_ceiling\": reversal_ceiling,\n        \"reversal_recognized\": reversal_recognized,\n    }\n",
