                "code": "def solve():\n    V_U = Q(1750)          # unlevered asset value, USD million\n    D_old = Q(225)         # existing debt\n    N0 = Q(40)             # original shares, millions\n    D_plan = Q(450)        # planned new debt\n    fee_rate = Q(\"0.03\")\n    ts_rate = Q(\"0.26\")\n    cap = Q(\"0.8\")\n\n    # post-repurchase equity as function of new debt D:\n    # E(D) = V_U + ts_rate*D - fee_rate*D - (D_old + D)\n    def equity_after_fn(D):\n        return V_U + ts_rate * D - fee_rate * D - (D_old + D)\n\n    # covenant: (D_old + D) / E(D) <= cap ; largest D meeting it exactly\n    # D_old + D = cap*(V_U - D_old) + cap*(ts_rate - fee_rate - 1)*D\n    D_max = (cap * (V_U - D_old) - D_old) / (1 - cap * (ts_rate - fee_rate - 1))\n    debt_issued = D_plan if D_plan <= D_max else D_max\n\n    net_proceeds = debt_issued * (1 - fee_rate)\n    equity_after = equity_after_fn(debt_issued)          # after repurchase\n    equity_with_cash = equity_after + net_proceeds        # just after issue, cash held\n    repurchase_price = equity_with_cash / N0              # USD per share\n\n    shares_repurchased = net_proceeds / repurchase_price\n    shares_after = N0 - shares_repurchased                # millions\n\n    return {\n        \"final\": shares_after,\n        \"debt_issued\": debt_issued,\n        \"repurchase_price\": repurchase_price,\n        \"equity_after\": equity_after,\n    }\n",
