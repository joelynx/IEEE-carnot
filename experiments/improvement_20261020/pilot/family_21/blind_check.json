                "code": "def solve():\n    long_notional = Q(160)\n    hedge_notional = Q(140)\n    vol_a = Q(\"0.024\")\n    vol_b = Q(\"0.011\")\n    rho = Q(\"-0.30\")\n    k = Q(\"2.35\")\n    limit = Q(\"2.5\")\n\n    def hedged_var(h):\n        # hedged daily variance with short hedge notional h\n        var_daily = (long_notional * vol_a) ** 2 + (h * vol_b) ** 2 \\\n            - 2 * rho * vol_a * vol_b * long_notional * h\n        return k * sqrt(var_daily)\n\n    initial_var = hedged_var(hedge_notional)\n\n    if initial_var <= limit:\n        applied_hedge = hedge_notional\n        applied_var = initial_var\n        rebal_cost = Q(0)\n    else:\n        # minimum-variance hedge notional (negative => long B)\n        applied_hedge = rho * (vol_a / vol_b) * long_notional\n        applied_var = hedged_var(applied_hedge)\n        rebal_cost = Q(\"0.001\") * abs(applied_hedge - hedge_notional)\n\n    rate = Q(\"0.10\")\n    within = min(applied_var, limit)\n    excess = max(applied_var - limit, 0)\n    capital_charge = rate * within + 3 * rate * excess + rebal_cost\n\n    return {\n        \"final\": capital_charge,\n        \"initial_var\": initial_var,\n        \"applied_hedge_notional\": applied_hedge,\n        \"applied_var\": applied_var,\n    }\n",
