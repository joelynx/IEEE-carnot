                "code": "def solve():\n    long_notional = 160          # USD million, long asset A\n    hedge_notional = 190         # USD million, short asset B\n    vol_a = 0.024\n    vol_b = 0.033\n    rho = 0.30\n    var_mult = 1.8\n    limit = 3                    # USD million\n    cost_rate = 0.001            # 0.10 percent of absolute change in hedge\n    charge_rate = 0.12\n\n    def hedged_var(h):\n        # hedged daily variance: long var + hedge var - 2*rho*volA*volB*NA*h\n        variance = (long_notional * vol_a) ** 2 + (h * vol_b) ** 2 \\\n                   - 2 * rho * vol_a * vol_b * long_notional * h\n        return var_mult * sqrt(variance)\n\n    initial_var = hedged_var(hedge_notional)\n\n    if initial_var <= limit:\n        applied_hedge = hedge_notional\n        applied_var = initial_var\n        rebalance_cost = 0\n    else:\n        # minimum-variance hedge: rho * (volA/volB) * long notional\n        applied_hedge = rho * vol_a / vol_b * long_notional\n        applied_var = hedged_var(applied_hedge)\n        rebalance_cost = cost_rate * abs(applied_hedge - hedge_notional)\n\n    # capital charge: 12% of VaR up to limit, 36% on excess above limit, plus cost\n    within = min(applied_var, limit)\n    excess = max(applied_var - limit, 0)\n    capital_charge = charge_rate * within + 3 * charge_rate * excess + rebalance_cost\n\n    return {\n        \"final\": capital_charge,\n        \"initial_var\": initial_var,\n        \"applied_hedge_notional\": applied_hedge,\n        \"applied_var\": applied_var,\n    }\n",
