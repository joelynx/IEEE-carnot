                "code": "def solve():\n    A = Q(60)          # long notional in asset A, USD million\n    H = Q(70)          # short hedge notional in asset B, USD million\n    sA = Q(\"0.021\")    # daily vol A\n    sB = Q(\"0.025\")    # daily vol B\n    rho = Q(\"0.40\")    # correlation\n    k = Q(\"2.2\")       # VaR multiplier\n    limit = Q(4)       # VaR limit, USD million\n    rate = Q(\"0.12\")   # capital rate up to limit\n    rebal_rate = Q(\"0.001\")  # 0.10% rebalancing cost\n\n    def var_with_hedge(h):\n        var = (A * sA) ** 2 + (h * sB) ** 2 - 2 * rho * sA * sB * A * h\n        return k * sqrt(var)\n\n    initial_var = var_with_hedge(H)\n\n    if initial_var <= limit:\n        applied_hedge = H\n        applied_var = initial_var\n        rebal_cost = Q(0)\n    else:\n        applied_hedge = rho * (sA / sB) * A   # minimum-variance hedge notional\n        applied_var = var_with_hedge(applied_hedge)\n        rebal_cost = rebal_rate * abs(applied_hedge - H)\n\n    within = min(applied_var, limit)\n    excess = max(applied_var - limit, 0)\n    charge = rate * within + 3 * rate * excess + rebal_cost\n\n    return {\n        \"final\": charge,\n        \"initial_var\": initial_var,\n        \"applied_hedge_notional\": applied_hedge,\n        \"applied_var\": applied_var,\n    }\n",
