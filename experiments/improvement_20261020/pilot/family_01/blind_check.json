                "code": "def solve():\n    net_income = 2300000\n    pref_div = 60000\n    base_shares = 1000000\n    new_shares = 180000\n    # Shares issued at start of month 10, outstanding months 10-12 (3 months of 12)\n    weighted_shares = base_shares + new_shares * Q(3, 12)\n    earnings = net_income - pref_div\n    basic_eps = earnings / weighted_shares\n\n    # (1) Contingent shares: revenue condition met -> include all year in diluted\n    contingent_shares = 100000 if 5750000 >= 5000000 else 0\n\n    # (2) Options: market price 19 < exercise 20 -> antidilutive, no incremental shares\n    exercise_price = 20\n    market_price = 19\n    if market_price > exercise_price:\n        option_incremental_shares = 200000 - 200000 * exercise_price / market_price\n    else:\n        option_incremental_shares = 0\n\n    # Diluted EPS after zero-incremental instruments\n    diluted_shares = weighted_shares + contingent_shares + option_incremental_shares\n    diluted_eps_step = earnings / diluted_shares\n\n    # (3) Convertible bonds\n    face = 2000000\n    coupon = Q(\"0.11\")\n    tax = Q(\"0.25\")\n    conv_shares = 50000\n    after_tax_interest = face * coupon * (1 - tax)\n    bond_incremental_eps = after_tax_interest / conv_shares\n\n    if bond_incremental_eps < diluted_eps_step:\n        diluted_eps = (earnings + after_tax_interest) / (diluted_shares + conv_shares)\n    else:\n        diluted_eps = diluted_eps_step\n\n    return {\n        \"final\": diluted_eps,\n        \"weighted_shares\": weighted_shares,\n        \"basic_eps\": basic_eps,\n        \"option_incremental_shares\": option_incremental_shares,\n        \"bond_incremental_eps\": bond_incremental_eps,\n    }\n",
