                "code": "def solve():\n    wd = Q(\"0.20\")           # debt weight\n    we = 1 - wd              # equity weight\n    KE = Q(\"12.5\")           # required equity return, percent\n    FE = Q(\"5.5\")            # flotation cost, percent of gross proceeds\n    D = Q(180)               # debt, USD million\n    KD = Q(\"6.25\")           # pretax debt cost, percent\n    EBITDA = Q(115)          # USD million\n    cap_pct = Q(\"0.30\")      # interest deductibility cap as fraction of EBITDA\n    T = Q(29)                # tax rate, percent\n\n    # Flotation-adjusted equity cost\n    ke_f = KE / (1 - FE / 100)\n\n    # Interest and deductible portion\n    interest = D * KD / 100\n    cap = cap_pct * EBITDA\n    deductible = min(interest, cap)\n\n    # After-tax debt cost with capped shield\n    kd_after = KD * (1 - (T / 100) * (deductible / interest))\n\n    # WACC\n    wacc = we * ke_f + wd * kd_after\n\n    return {\n        \"final\": wacc,\n        \"flotation_adjusted_equity_cost_percent\": ke_f,\n        \"deductible_interest\": deductible,\n        \"after_tax_debt_cost_percent\": kd_after,\n    }\n",
