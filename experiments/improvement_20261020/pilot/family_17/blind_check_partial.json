              "code": "def solve():\n    cash_per_share = Q(\"17.5\")\n    base_ratio = Q(\"0.9\")\n    low, high = Q(47), Q(60)\n    price = Q(40)\n    shares_m = Q(59)  # million shares\n    net_debt_m = Q(220)\n    ebitda_m = Q(95)\n    hurdle_m = Q(100)\n    cap_m = Q(60)\n    r = Q(\"0.08\")\n\n    # Collar: below floor, stock component fixed at 0.9 * 47\n    if price < low:\n        stock_value_per_share = base_ratio * low\n    elif price > high:\n        stock_value_per_share = base_ratio * high\n    else:\n        stock_value_per_share = base_ratio * price\n    effective_exchange_ratio = stock_value_per_share / price\n\n    # Equity consideration across all T shares (million USD)\n    equity_consideration = shares_m * (cash_per_share + stock_value_per_share)\n\n    # Earnout: 50% of EBITDA above hurdle, capped, zero if not above hurdle\n    excess = ebitda_m - hurdle_m\n    earnout = Q(0) if excess <= 0 else min(Q(\"0.5\") * excess, cap_m)\n    earnout_present_value = earnout / (1 + r)\n\n    total = equity_consideration + net_debt_m + earnout_present_value\n\n    return {\n        \"final\": total,\n        \"effective_exchange_ratio\": effective_exchange_ratio,\n        \"equity_consideration\": equity_consideration,\n        \"earnout_present_value\": earnout_present_value,\n    }\n",
