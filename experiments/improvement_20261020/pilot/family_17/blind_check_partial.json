              "code": "def solve():\n    cash_per_share = Q(\"15.5\")\n    base_ratio = Q(\"1.2\")\n    lower, upper = Q(43), Q(62)\n    price = Q(38)\n    shares_m = Q(23)  # million T shares\n    net_debt_m = Q(330)\n\n    # Collar: below lower bound, stock component worth 1.2 * 43\n    if price < lower:\n        stock_value_per_share = base_ratio * lower\n    elif price > upper:\n        stock_value_per_share = base_ratio * upper\n    else:\n        stock_value_per_share = base_ratio * price\n    effective_exchange_ratio = stock_value_per_share / price\n\n    # Equity consideration across all T shares (million USD)\n    equity_consideration = (cash_per_share + stock_value_per_share) * shares_m\n\n    # Earnout\n    ebitda = Q(115)\n    hurdle = Q(100)\n    earnout = max(Q(0), Q(\"0.5\") * (ebitda - hurdle))\n    earnout = min(earnout, Q(60))\n    earnout_pv = earnout / (1 + Q(\"0.08\"))\n\n    total = equity_consideration + net_debt_m + earnout_pv\n\n    return {\n        \"final\": total,\n        \"effective_exchange_ratio\": effective_exchange_ratio,\n        \"equity_consideration\": equity_consideration,\n        \"earnout_present_value\": earnout_pv,\n    }\n",
