                "code": "def solve():\n    savings = Q(\"33.5\")\n    realization = [Q(\"0.45\"), Q(\"0.75\"), Q(1)]\n    integration = [Q(\"53.5\"), Q(30), Q(0)]\n    tax = Q(\"0.28\")\n\n    # After-tax net cash flow per year (same rate applied to negative pre-tax net => tax credit)\n    def net(year):  # year is 1-based\n        r = realization[year - 1] if year <= 3 else Q(1)\n        c = integration[year - 1] if year <= 3 else Q(0)\n        return (savings * r - c) * (1 - tax)\n\n    year1_net = net(1)  # negative if net cost\n    year2_net = net(2)\n    cumulative_end_year2 = year1_net + year2_net\n\n    # Break-even time\n    if year1_net >= 0:\n        breakeven_year = 1\n        breakeven_time = Q(0)\n    else:\n        cum = Q(0)\n        k = 1\n        while True:\n            start = cum\n            cf = net(k)\n            cum = start + cf\n            if cum >= 0:\n                breakeven_year = k\n                shortfall = -start  # positive shortfall at start of year k\n                breakeven_time = (k - 1) + shortfall / cf\n                break\n            k += 1\n\n    return {\n        \"final\": breakeven_time,\n        \"year1_net_after_tax\": year1_net,\n        \"cumulative_end_year2\": cumulative_end_year2,\n        \"breakeven_year\": breakeven_year,\n    }\n",
