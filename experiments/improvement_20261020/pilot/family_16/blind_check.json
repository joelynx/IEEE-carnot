                "code": "def solve():\n    savings = Q(\"45.5\")\n    realization = {1: Q(\"0.35\"), 2: Q(\"0.85\")}\n    integration = {1: Q(52), 2: Q(14)}\n    tax = Q(\"0.19\")\n\n    def net_cf(year):\n        r = realization.get(year, Q(1))\n        pre_tax = savings * r - integration.get(year, Q(0))\n        return pre_tax * (1 - tax)  # tax credit on negative pre-tax at same rate\n\n    year1_net = net_cf(1)\n    cumulative = Q(0)\n    cumulative_end_year2 = None\n    breakeven_year = None\n    breakeven_time = None\n\n    if year1_net >= 0:\n        breakeven_time = Q(0)\n        breakeven_year = 1\n\n    year = 1\n    while year <= 100:\n        start_balance = cumulative\n        cf = net_cf(year)\n        cumulative = start_balance + cf\n        if year == 2:\n            cumulative_end_year2 = cumulative\n        if breakeven_year is None and cumulative >= 0:\n            breakeven_year = year\n            shortfall = -start_balance  # positive shortfall at start of year k\n            breakeven_time = (year - 1) + shortfall / cf\n        if year >= 2 and breakeven_year is not None:\n            break\n        year += 1\n\n    return {\n        \"final\": breakeven_time,\n        \"year1_net_after_tax\": year1_net,\n        \"cumulative_end_year2\": cumulative_end_year2,\n        \"breakeven_year\": breakeven_year,\n    }\n",
