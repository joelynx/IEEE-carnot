                "code": "def solve():\n    savings = Q(\"42.5\")\n    realization = [Q(\"0.4\"), Q(\"0.85\"), Q(1)]\n    integration = [Q(45), Q(\"1.5\"), Q(0)]\n    tax = Q(\"0.21\")\n\n    # after-tax net cash flows per year (tax credit applies to negative pre-tax net)\n    def net_cf(year_idx):\n        r = realization[min(year_idx, 2)]\n        ic = integration[min(year_idx, 2)]\n        return (savings * r - ic) * (1 - tax)\n\n    year1_net = net_cf(0)  # negative if net cost\n\n    cumulative = Q(0)\n    cum_end_year2 = None\n    breakeven_year = None\n    breakeven_time = None\n\n    if year1_net >= 0:\n        breakeven_time = Q(0)\n        breakeven_year = 1\n        cum_end_year2 = year1_net + net_cf(1)\n    else:\n        k = 1\n        while True:\n            cf = net_cf(k - 1)\n            start_balance = cumulative\n            cumulative += cf\n            if k == 2:\n                cum_end_year2 = cumulative\n            if cumulative >= 0 and breakeven_year is None:\n                breakeven_year = k\n                shortfall = -start_balance  # positive deficit at start of year k\n                breakeven_time = (k - 1) + shortfall / cf\n            if breakeven_year is not None and cum_end_year2 is not None:\n                break\n            k += 1\n\n    return {\n        \"final\": breakeven_time,\n        \"year1_net_after_tax\": year1_net,\n        \"cumulative_end_year2\": cum_end_year2,\n        \"breakeven_year\": breakeven_year,\n    }\n",
