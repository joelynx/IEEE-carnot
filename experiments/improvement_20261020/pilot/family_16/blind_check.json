                "code": "def solve():\n    savings = Q(\"49.5\")\n    realization = [Q(\"0.4\"), Q(\"0.7\"), Q(1), Q(1), Q(1), Q(1), Q(1), Q(1), Q(1), Q(1)]\n    integration = [Q(52), Q(\"7.5\")] + [Q(0)] * 8\n    tax = Q(\"0.34\")\n\n    net = []\n    for r, c in zip(realization, integration):\n        pre_tax = savings * r - c\n        net.append(pre_tax * (1 - tax))  # tax credit if negative at same rate\n\n    year1_net_after_tax = net[0]\n\n    # cumulative balances at end of each year\n    cum = []\n    bal = Q(0)\n    for n in net:\n        bal += n\n        cum.append(bal)\n    cumulative_end_year2 = cum[1]\n\n    # break-even\n    if net[0] >= 0:\n        breakeven_time = Q(0)\n        breakeven_year = 1\n    else:\n        breakeven_year = None\n        start_bal = Q(0)\n        for k, n in enumerate(net, start=1):\n            end_bal = start_bal + n\n            if end_bal >= 0:\n                breakeven_year = k\n                shortfall = -start_bal  # positive shortfall at start of year k\n                breakeven_time = (k - 1) + shortfall / n\n                break\n            start_bal = end_bal\n\n    return {\n        \"final\": breakeven_time,\n        \"year1_net_after_tax\": year1_net_after_tax,\n        \"cumulative_end_year2\": cumulative_end_year2,\n        \"breakeven_year\": breakeven_year,\n    }\n",
