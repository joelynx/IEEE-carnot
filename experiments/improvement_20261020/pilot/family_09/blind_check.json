                "code": "def solve():\n    face = Q(1000)\n    y = Q(\"0.07\")\n    days = Q(120)\n    year_days = Q(360)\n\n    # Principal schedule\n    p1 = face * Q(\"0.30\")            # repaid end of year 1\n    p2 = face * Q(\"0.20\")            # repaid end of year 2\n    outstanding_y1 = face            # during year 1\n    outstanding_y2 = face - p1       # during year 2\n    outstanding_y3 = face - p1 - p2  # during year 3 (= principal after year-2 installment)\n    principal_after_year2 = outstanding_y3\n\n    # Coupon rates\n    r1 = Q(\"0.035\")\n    r2 = r1 + Q(-100) / Q(10000)     # -100 bp from year 2 onward\n    r3 = r2\n\n    # Cash flows\n    cf1 = r1 * outstanding_y1 + p1\n    cf2 = r2 * outstanding_y2 + p2\n    cf3 = r3 * outstanding_y3 + outstanding_y3\n\n    # Call decision at end of year 2\n    call_payment = Q(\"1.01\") * outstanding_y3\n    pv_year3_at_year2 = cf3 / (1 + y)\n    call_decision = \"call\" if call_payment < pv_year3_at_year2 else \"no_call\"\n\n    # Investor's cash flows\n    year2_total_received = cf2 + (call_payment if call_decision == \"call\" else Q(0))\n    t_adj = days / year_days\n    pv = cf1 / (1 + y) ** (1 - t_adj) + year2_total_received / (1 + y) ** (2 - t_adj)\n    if call_decision == \"no_call\":\n        pv += cf3 / (1 + y) ** (3 - t_adj)\n\n    return {\n        \"final\": pv,\n        \"principal_after_year2\": principal_after_year2,\n        \"pv_year3_at_year2\": pv_year3_at_year2,\n        \"call_decision\": call_decision,\n        \"year2_total_received\": year2_total_received,\n    }\n",
