              "code": "def solve():\n    invoice_fc = 195000\n    hedge_ratio = Q(\"0.45\")\n    fwd_rate = Q(\"6.6\")       # FC per USD\n    fwd_fee = 100             # flat USD\n    spot_rate = Q(\"5.7\")      # FC per USD\n    spot_bps = Q(\"0.0055\")    # 55 bp of USD spent on spot\n    domestic_adj = Q(\"0.01\")  # +1% of total USD paid to bank\n\n    # Hedged leg: FC bought forward converted to USD plus flat fee\n    hedged_fc = invoice_fc * hedge_ratio\n    hedged_leg_usd = hedged_fc / fwd_rate + fwd_fee\n\n    # Spot leg: remainder at spot plus basis-point fee on USD spent\n    unhedged_fc = invoice_fc - hedged_fc\n    spot_usd = unhedged_fc / spot_rate\n    spot_leg_usd = spot_usd * (1 + spot_bps)\n\n    # Total paid to bank, then signed domestic clearance adjustment\n    bank_total = hedged_leg_usd + spot_leg_usd\n    total_usd_cost = bank_total * (1 + domestic_adj)\n\n    # Effective all-in rate: FC per USD\n    effective_rate = invoice_fc / total_usd_cost\n\n    return {\n        \"final\": effective_rate,\n        \"hedged_leg_usd\": hedged_leg_usd,\n        \"spot_leg_usd\": spot_leg_usd,\n        \"total_usd_cost\": total_usd_cost,\n    }\n",
