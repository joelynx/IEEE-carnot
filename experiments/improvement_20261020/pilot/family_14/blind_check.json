                "code": "def solve():\n    r = Q(\"0.12\")\n    capex0 = Q(5000)\n    capex_y2_begin = Q(3000)  # beginning of year 2 = end of year 1\n    inflows = [Q(5000), Q(5000), Q(5000)]  # years 1..3, 0% growth\n    wc_pct = Q(\"0.25\")\n    recovery_pct = Q(\"0.60\")\n\n    df = lambda t: 1 / (1 + r) ** t\n\n    # PV of staged capex (outflows, positive magnitude)\n    pv_staged_capex = capex0 * df(0) + capex_y2_begin * df(1)\n\n    # PV of operating inflows at year-ends\n    pv_operating_inflows = sum(inflows[t - 1] * df(t) for t in range(1, 4))\n\n    # Working capital adjustments at beginning of each year (end of year t-1)\n    pv_wc_adjustments = Q(0)\n    prior = Q(0)\n    for t in range(1, 4):\n        balance = wc_pct * inflows[t - 1]\n        change = balance - prior  # increase = outflow (positive)\n        pv_wc_adjustments += change * df(t - 1)\n        prior = balance\n\n    # Release of recovered working capital at end of year 3\n    pv_wc_release = recovery_pct * prior * df(3)\n\n    npv = -pv_staged_capex + pv_operating_inflows - pv_wc_adjustments + pv_wc_release\n\n    return {\n        \"final\": npv,\n        \"pv_staged_capex\": pv_staged_capex,\n        \"pv_operating_inflows\": pv_operating_inflows,\n        \"pv_wc_adjustments\": pv_wc_adjustments,\n        \"pv_wc_release\": pv_wc_release,\n    }\n",
