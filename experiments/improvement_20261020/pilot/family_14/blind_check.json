                "code": "def solve():\n    r = Q(\"0.08\")\n    g = Q(\"-0.075\")\n    wc_rate = Q(\"0.15\")\n    n = 4\n\n    # Inflows at end of years 1..4\n    inflows = [Q(3500) * (1 + g) ** (t - 1) for t in range(1, n + 1)]\n\n    # Capex: 8500 at time 0, 6000 at beginning of year 2 (= end of year 1)\n    pv_staged_capex = Q(8500) + Q(6000) / (1 + r) ** 1\n\n    # Operating inflows PV\n    pv_operating_inflows = sum(inflows[t - 1] / (1 + r) ** t for t in range(1, n + 1))\n\n    # Working capital: balance at beginning of year t = 15% of inflow of year t, set at end of year t-1\n    pv_wc_adjustments = Q(0)  # positive = net outflow\n    prev_balance = Q(0)\n    for t in range(1, n + 1):\n        balance = wc_rate * inflows[t - 1]\n        adjustment = balance - prev_balance  # increase = outflow\n        pv_wc_adjustments += adjustment / (1 + r) ** (t - 1)\n        prev_balance = balance\n\n    # Release at end of year 4: 60% of final balance recovered\n    final_balance = prev_balance\n    pv_wc_release = Q(\"0.60\") * final_balance / (1 + r) ** n\n\n    npv = -pv_staged_capex + pv_operating_inflows - pv_wc_adjustments + pv_wc_release\n\n    return {\n        \"final\": npv,\n        \"pv_staged_capex\": pv_staged_capex,\n        \"pv_operating_inflows\": pv_operating_inflows,\n        \"pv_wc_adjustments\": pv_wc_adjustments,\n        \"pv_wc_release\": pv_wc_release,\n    }\n",
