                "code": "def solve():\n    L0 = Q(1300000)\n    E_start = Q(250000)\n    net_result = Q(-10000)\n    repay_share = Q(\"0.30\")\n    fee_rate = Q(0)\n    de_max = Q(\"1.75\")\n    ea_min = Q(\"0.43\")\n\n    # Equity after booking the net result (loss reduces equity)\n    E0 = E_start + net_result\n\n    # For injection X: L = L0 - s*X ; E = E0 + X - fee_rate*s*X\n    # Let a = coefficient of X in equity, s = repay share\n    a = 1 - fee_rate * repay_share\n    s = repay_share\n\n    # Debt-to-equity: L0 - s*X <= de_max*(E0 + a*X)\n    # -> X*(de_max*a + s) >= L0 - de_max*E0\n    need_de = L0 - de_max * E0\n    X_de = need_de / (de_max * a + s)\n    injection_leverage_only = X_de if X_de > 0 else Q(0)\n\n    # Equity-to-assets: (E0 + a*X) >= ea_min*(L0 - s*X + E0 + a*X)\n    # -> X*(a - ea_min*(a - s)) >= ea_min*(L0 + E0) - E0\n    need_ea = ea_min * (L0 + E0) - E0\n    X_ea = need_ea / (a - ea_min * (a - s))\n    injection_equity_ratio_only = X_ea if X_ea > 0 else Q(0)\n\n    # Minimum injection satisfying both: the larger of the two requirements\n    final = max(injection_leverage_only, injection_equity_ratio_only)\n\n    return {\n        \"final\": final,\n        \"equity_after_result\": E0,\n        \"injection_leverage_only\": injection_leverage_only,\n        \"injection_equity_ratio_only\": injection_equity_ratio_only,\n    }\n",
