              "code": "def solve():\n    core_value = 250  # USD million\n    sigma_E = 18  # percent\n    sigma_H = 28  # percent\n    rho = Q(\"-0.4\")\n    target_vol = 9  # percent\n\n    core_variance_pp2 = sigma_E ** 2  # 324\n    futures_variance_pp2 = sigma_H ** 2  # 784\n    cov_pp2 = rho * sigma_E * sigma_H\n\n    # Minimum-variance overlay ratio: h* = -rho*sigma_E/sigma_H\n    h_min = -cov_pp2 / futures_variance_pp2\n    min_variance_pp2 = core_variance_pp2 + h_min ** 2 * futures_variance_pp2 + 2 * h_min * cov_pp2\n\n    target_variance = target_vol ** 2\n\n    if target_variance >= min_variance_pp2:\n        target_attainable = \"attainable\"\n        # Solve h^2*sH^2 + 2h*cov + (sE^2 - target) = 0\n        a = futures_variance_pp2\n        b = 2 * cov_pp2\n        c = core_variance_pp2 - target_variance\n        disc = b * b - 4 * a * c\n        root = sqrt(disc)\n        h1 = (-b + root) / (2 * a)\n        h2 = (-b - root) / (2 * a)\n        # choose smaller absolute value; negative if tied\n        if abs(h1) < abs(h2):\n            selected_hedge_ratio = h1\n        elif abs(h2) < abs(h1):\n            selected_hedge_ratio = h2\n        else:\n            selected_hedge_ratio = min(h1, h2)\n    else:\n        target_attainable = \"unattainable\"\n        selected_hedge_ratio = h_min\n\n    futures_notional = selected_hedge_ratio * core_value  # signed, USD million\n\n    return {\n        \"final\": futures_notional,\n        \"core_variance_pp2\": core_variance_pp2,\n        \"min_variance_pp2\": min_variance_pp2,\n        \"target_attainable\": target_attainable,\n        \"selected_hedge_ratio\": selected_hedge_ratio,\n    }\n",
