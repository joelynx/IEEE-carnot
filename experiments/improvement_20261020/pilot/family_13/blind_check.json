                "code": "def solve():\n    equity = Q(1260)\n    bonds = Q(1520)\n    cost = Q(\"0.018\")\n    target = Q(\"0.70\")\n    withdrawal = Q(130)\n    net_ratio = 1 - cost\n\n    # Withdrawal funded by gross bond sale with net proceeds equal to withdrawal\n    withdrawal_gross_sale = withdrawal / net_ratio\n    bonds_after_wd = bonds - withdrawal_gross_sale\n    total_after_wd = equity + bonds_after_wd\n    post_withdrawal_weight = equity / total_after_wd * 100  # percent\n\n    if equity / total_after_wd < target:\n        # Underweight: sell bonds gross G, equity gains G*net_ratio\n        # equity + G*n = target*(total_after_wd + G*(n-1))\n        G = (target * total_after_wd - equity) / (net_ratio - target * (net_ratio - 1))\n        equity_trade = G * net_ratio  # buy\n        final_total = total_after_wd + G * (net_ratio - 1)\n    elif equity / total_after_wd > target:\n        # Overweight: sell equity gross G, bonds gain G*net_ratio\n        # equity - G = target*(total_after_wd + G*(n-1))\n        G = (equity - target * total_after_wd) / (1 + target * (net_ratio - 1))\n        equity_trade = -G  # sell\n        final_total = total_after_wd + G * (net_ratio - 1)\n    else:\n        equity_trade = Q(0)\n        final_total = total_after_wd\n\n    return {\n        \"final\": final_total,\n        \"withdrawal_gross_sale\": withdrawal_gross_sale,\n        \"post_withdrawal_weight\": post_withdrawal_weight,\n        \"equity_trade\": equity_trade,\n    }\n",
