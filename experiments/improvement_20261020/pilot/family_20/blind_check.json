                "code": "def solve():\n    V = Q(382500)\n    e = Q(\"6.5\")   # signed equity change, percent\n    f = Q(\"2.5\")   # signed FX change, percent\n    b = Q(\"0.6\")   # raw equity sensitivity\n    h = Q(0)       # hedge coverage percent\n    d = Q(-1)      # FX sensitivity\n    k = Q(\"0.5\")   # interaction coefficient\n\n    # Net equity sensitivity after hedge\n    net_equity_sensitivity = b * (1 - h / 100)\n\n    # Factor ratios\n    e_ratio = e / 100\n    f_ratio = f / 100\n\n    # Effects on value ratio\n    net_equity_effect = net_equity_sensitivity * e_ratio\n    fx_effect = d * f_ratio\n    cross_effect_ratio = k * e_ratio * f_ratio  # hedge not applied\n\n    total_ratio = net_equity_effect + fx_effect + cross_effect_ratio\n\n    # Signed value change in USD\n    signed_value_change = V * total_ratio\n\n    # Loss magnitude: positive size of decline, else 0\n    loss_magnitude = -signed_value_change if signed_value_change < 0 else Q(0)\n\n    return {\n        \"final\": loss_magnitude,\n        \"net_equity_sensitivity\": net_equity_sensitivity,\n        \"cross_effect_ratio\": cross_effect_ratio,\n        \"signed_value_change\": signed_value_change,\n    }\n",
