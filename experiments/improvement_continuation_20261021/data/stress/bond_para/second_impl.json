 "program": "def solve():\n    face = Q(P[\"FACE\"])\n    a1 = Q(P[\"A1_PCT\"]) / 100\n    a2 = Q(P[\"A2_PCT\"]) / 100\n    c1 = Q(P[\"C1_PCT\"]) / 100\n    step = Q(P[\"STEP_BP\"]) / 10000\n    y = Q(P[\"Y_PCT\"]) / 100\n    call_mult = Q(P[\"CALL_PCT\"]) / 100\n    days = Q(P[\"DAYS\"])\n\n    # coupon rates per year: year 1 at c1, from year 2 onward shifted by step\n    rates = {1: c1, 2: c1 + step, 3: c1 + step}\n\n    # principal ledger\n    outstanding = face\n    ledger = {}\n    # year 1\n    coupon1 = rates[1] * outstanding\n    inst1 = a1 * face\n    outstanding -= inst1\n    ledger[1] = coupon1 + inst1\n    # year 2\n    coupon2 = rates[2] * outstanding\n    inst2 = a2 * face\n    outstanding -= inst2\n    principal_after_year2 = outstanding\n    sched2 = coupon2 + inst2\n    # year 3 scheduled\n    coupon3 = rates[3] * outstanding\n    inst3 = outstanding\n    sched3 = coupon3 + inst3\n\n    pv3_at2 = sched3 / (1 + y)\n    call_payment = call_mult * principal_after_year2\n\n    if call_payment < pv3_at2:\n        decision = \"call\"\n        year2_total = sched2 + call_payment\n        flows = {1: ledger[1], 2: year2_total}\n    else:\n        decision = \"no_call\"\n        year2_total = sched2\n        flows = {1: ledger[1], 2: year2_total, 3: sched3}\n\n    def df(k):\n        t = Q(k) - days / 360\n        return exp(-t * ln(1 + y))\n\n    price = 0\n    for k, cf in flows.items():\n        price += cf * df(k)\n\n    return {\n        \"final\": price,\n        \"principal_after_year2\": principal_after_year2,\n        \"pv_year3_at_year2\": pv3_at2,\n        \"call_decision\": decision,\n        \"year2_total_received\": year2_total,\n    }\n",
