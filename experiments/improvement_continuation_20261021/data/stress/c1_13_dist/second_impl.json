 "program": "def solve():\n    D0 = Q(P[\"D0\"])\n    g1 = Q(P[\"G1_BP\"]) / 10000\n    n = int(P[\"N_Q\"])\n    g2_annual = Q(P[\"G2_PCT\"]) / 100\n    r_eff = Q(P[\"R_EFF\"]) / 100\n    conv = P[\"CONV\"]\n\n    # effective annual -> compounded quarterly: (1+r)^(1/4) = sqrt(sqrt(1+r))\n    growth_factor_r = sqrt(sqrt(1 + r_eff))\n    q = growth_factor_r - 1\n\n    # stage-two quarterly growth\n    if conv == \"compound\":\n        gq = sqrt(sqrt(1 + g2_annual)) - 1\n    elif conv == \"nominal\":\n        gq = g2_annual / 4\n    else:\n        raise ValueError(\"unknown convention\")\n\n    if not (gq < q):\n        raise ValueError(\"stage-two growth must be below quarterly rate\")\n\n    # period-by-period ledger of stage-one dividends\n    div = D0\n    disc = 1\n    pv_stage_one = 0\n    for t in range(1, n + 1):\n        div = div * (1 + g1)\n        disc = disc * growth_factor_r\n        pv_stage_one += div / disc\n\n    d_next = div * (1 + gq)\n    terminal = d_next / (q - gq)\n    price = pv_stage_one + terminal / disc\n\n    return {\n        \"final\": price,\n        \"quarterly_rate\": q * 100,\n        \"stage_one_pv\": pv_stage_one,\n        \"terminal_value\": terminal,\n    }\n",
