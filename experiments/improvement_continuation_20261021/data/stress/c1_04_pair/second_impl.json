 "program": "def solve():\n    cogs = Q(P[\"COGS\"])\n    inv_o = Q(P[\"INV_OPEN\"]); inv_c = Q(P[\"INV_CLOSE\"])\n    ap_o = Q(P[\"AP_OPEN\"]); ap_c = Q(P[\"AP_CLOSE\"])\n    adv_o = Q(P[\"ADV_OPEN\"]); adv_c = Q(P[\"ADV_CLOSE\"])\n    share_settle = Q(P[\"SHARE_SETTLE\"])\n\n    # Inventory ledger: open + purchases - COGS = close\n    purchases = inv_c - inv_o + cogs\n\n    # Payables ledger: open + purchases - settlements = close\n    # settlements = cash settlements (incl. share-funded cash) + advance drawdowns\n    payables_change = ap_c - ap_o\n    total_settlements = ap_o + purchases - ap_c\n\n    # Advances ledger: open + cash advances - drawdowns = close\n    # Cash paid = cash settlements + cash advances\n    #           = (total_settlements - drawdowns) + cash_advances\n    #           = total_settlements + (adv_c - adv_o)\n    cash_paid = total_settlements + (adv_c - adv_o)\n\n    # share-funded settlement of payables is cash paid to suppliers and is\n    # already embedded in the payables settlements; no further adjustment.\n    _ = share_settle\n\n    net_wc_change = (inv_c + adv_c - ap_c) - (inv_o + adv_o - ap_o)\n\n    if cash_paid < 0:\n        raise ValueError(\"implied cash paid to suppliers is negative; data inconsistent\")\n\n    return {\n        \"final\": cash_paid,\n        \"purchases\": purchases,\n        \"payables_change\": payables_change,\n        \"net_wc_change\": net_wc_change,\n    }\n",
