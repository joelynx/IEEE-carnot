 "program": "def solve():\n    from fractions import Fraction\n    from decimal import Decimal, getcontext\n    getcontext().prec = 60\n\n    y1 = Fraction(P[\"Y1\"]) / 100\n    y2 = Fraction(P[\"Y2\"]) / 100\n    y3 = Fraction(P[\"Y3\"]) / 100\n    spread = Fraction(P[\"SPREAD_BP\"]) / 10000\n    face = Fraction(P[\"FACE\"])\n\n    # Bootstrap discount factors from par yields (shortest maturity first)\n    d1 = 1 / (1 + y1)\n    d2 = (1 - y2 * d1) / (1 + y2)\n    if d2 <= 0:\n        raise ValueError(\"Inconsistent par yields: non-positive two-year discount factor\")\n    d3 = (1 - y3 * (d1 + d2)) / (1 + y3)\n    if d3 <= 0:\n        raise ValueError(\"Inconsistent par yields: non-positive three-year discount factor\")\n\n    def frac_to_dec(fr):\n        return Decimal(fr.numerator) / Decimal(fr.denominator)\n\n    # Zero rates: (1+z_t)^t = 1/d_t\n    inv_d2 = frac_to_dec(1 / d2)\n    inv_d3 = frac_to_dec(1 / d3)\n    z2 = inv_d2.sqrt() - 1\n    z3 = inv_d3 ** (Decimal(1) / Decimal(3)) - 1\n\n    # Forward rate: (1+f) = (1+z3)^3/(1+z2)^2 = d2/d3 (exact)\n    f = d2 / d3 - 1\n\n    # Coupon-in-advance bond: coupons at t=0,1,2; face at t=3\n    coupon_rate = y3 + spread\n    if coupon_rate < 0:\n        coupon_rate = Fraction(0)\n    coupon = face * coupon_rate\n    cashflows = [(coupon, Fraction(1)), (coupon, d1), (coupon, d2), (face, d3)]\n    price = Fraction(0)\n    for cf, df in cashflows:\n        price += cf * df\n\n    return {\n        \"final\": price,\n        \"two_year_zero_rate\": Fraction(z2) * 100,\n        \"three_year_zero_rate\": Fraction(z3) * 100,\n        \"forward_rate_2y1y\": f * 100,\n    }\n",
