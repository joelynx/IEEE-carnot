 "program": "def solve():\n    gross = Fraction(P[\"GROSS_T1\"])\n    goodwill = Fraction(P[\"GOODWILL\"])\n    dta = Fraction(P[\"DTA\"])\n    thresh_pct = Fraction(P[\"DTA_THRESH_PCT\"])\n    on_bs = Fraction(P[\"ON_BS\"])\n    undrawn = Fraction(P[\"UNDRAWN\"])\n    ccf_pct = Fraction(P[\"CCF_PCT\"])\n    min_pct = Fraction(P[\"MIN_PCT\"])\n\n    # Deductions ledger\n    threshold_amount = gross * thresh_pct / 100\n    excess_dta = dta - threshold_amount\n    dta_deduction = excess_dta if excess_dta > 0 else Fraction(0)\n    deductions = goodwill + dta_deduction\n    tier1 = gross - deductions\n    if tier1 <= 0:\n        raise ValueError(\"Tier 1 capital after deductions is zero or negative\")\n\n    # Exposure measure\n    converted_undrawn = undrawn * ccf_pct / 100\n    exposure = on_bs + converted_undrawn\n\n    ratio_pct = tier1 / exposure * 100\n\n    # Shortfall: capital needed so that (tier1 + x)/exposure*100 == min_pct\n    required_capital = min_pct / 100 * exposure\n    shortfall = required_capital - tier1\n    if shortfall < 0:\n        shortfall = Fraction(0)\n\n    return {\n        \"final\": shortfall,\n        \"tier1_after_deductions\": tier1,\n        \"exposure_measure\": exposure,\n        \"leverage_ratio_percent\": ratio_pct,\n    }\n",
