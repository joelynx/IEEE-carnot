 "program": "def solve():\n    premium = Q(P[\"PREMIUM\"])\n    policy_months = int(P[\"POLICY_MONTHS\"])\n    start_month = int(P[\"START_MONTH\"])\n    principal = Q(P[\"PRINCIPAL\"])\n    rate = Q(P[\"RATE\"])\n    loan_month = int(P[\"LOAN_MONTH\"])\n    pay_interval = int(P[\"PAY_INTERVAL\"])\n\n    # --- Insurance: month-by-month ledger of coverage used in the fiscal year ---\n    monthly_premium = premium / policy_months\n    insurance_expense = Q(0)\n    prepaid = premium\n    for m in range(start_month, 13):\n        used = m - start_month + 1  # months of coverage consumed by end of month m\n        if used <= policy_months:\n            insurance_expense += monthly_premium\n            prepaid -= monthly_premium\n    # prepaid left at 31 Dec: coverage months not yet used\n    # (ledger above already reduced it)\n\n    # --- Loan interest: month-by-month accrual and periodic cash payment ---\n    monthly_interest = principal * (rate / 100) / 12\n    interest_expense = Q(0)\n    accrued = Q(0)\n    months_since_draw = 0\n    for m in range(loan_month, 13):\n        interest_expense += monthly_interest\n        accrued += monthly_interest\n        months_since_draw += 1\n        if months_since_draw % pay_interval == 0:\n            # payment at end of this month (including 31 Dec)\n            accrued -= monthly_interest * pay_interval\n\n    total = insurance_expense + interest_expense\n\n    return {\n        \"final\": total,\n        \"prepaid_insurance_asset\": prepaid,\n        \"accrued_interest_liability\": accrued,\n        \"insurance_expense\": insurance_expense,\n    }\n",
