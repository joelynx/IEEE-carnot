 "program": "def solve():\n    D0 = P[\"D0\"]\n    G1_BP = P[\"G1_BP\"]\n    N_Q = P[\"N_Q\"]\n    G2_PCT = P[\"G2_PCT\"]\n    R_EFF = P[\"R_EFF\"]\n    CONV = P[\"CONV\"]\n\n    # Effective annual -> equivalent compounded quarterly rate: (1+R)^(1/4) - 1\n    one_plus_annual = 1 + R_EFF / 100\n    q = sqrt(sqrt(one_plus_annual)) - 1\n\n    # Stage-two quarterly growth\n    g2_annual = G2_PCT / 100\n    if CONV == \"compound\":\n        gq = sqrt(sqrt(1 + g2_annual)) - 1\n    elif CONV == \"nominal\":\n        gq = g2_annual / 4\n    else:\n        raise ValueError(\"unknown convention\")\n\n    if not (gq < q):\n        raise ValueError(\"stage-two quarterly growth must be below the quarterly rate\")\n\n    # Stage-one ledger: quarter 1 dividend = D0 (no growth), then each grows by G1_BP bp\n    step = 1 + Q(G1_BP, 10000)\n    div = D0\n    disc = 1\n    pv1 = 0\n    for k in range(1, N_Q + 1):\n        if k > 1:\n            div = div * step\n        disc = disc * (1 + q)\n        pv1 = pv1 + div / disc\n    last_div = div\n    disc_N = disc  # (1+q)^N_Q\n\n    # Terminal value at end of last stage-one quarter\n    first_stage2_div = last_div * (1 + gq)\n    tv = first_stage2_div / (q - gq)\n\n    price = pv1 + tv / disc_N\n\n    return {\n        \"final\": price,\n        \"quarterly_rate\": q * 100,\n        \"stage_one_pv\": pv1,\n        \"terminal_value\": tv,\n    }\n",
