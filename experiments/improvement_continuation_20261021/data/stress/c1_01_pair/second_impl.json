 "program": "def solve():\n    premium = Q(P[\"PREMIUM\"])\n    policy_months = int(P[\"POLICY_MONTHS\"])\n    start_month = int(P[\"START_MONTH\"])\n    principal = Q(P[\"PRINCIPAL\"])\n    rate = Q(P[\"RATE\"])\n    loan_month = int(P[\"LOAN_MONTH\"])\n    pay_interval = int(P[\"PAY_INTERVAL\"])\n\n    # --- Insurance: month-by-month ledger of coverage usage ---\n    monthly_ins = premium / policy_months\n    prepaid = premium\n    insurance_expense = Q(0)\n    covered_until = start_month + policy_months - 1  # last coverage month index (may exceed 12)\n    for m in range(1, 13):\n        if start_month <= m <= covered_until:\n            insurance_expense += monthly_ins\n            prepaid -= monthly_ins\n\n    # --- Loan interest: month-by-month accrual and payment ledger ---\n    monthly_int = principal * rate / 100 / 12\n    accrued = Q(0)\n    interest_expense = Q(0)\n    for m in range(1, 13):\n        if m > loan_month:\n            accrued += monthly_int\n            interest_expense += monthly_int\n        # payment at end of each PAY_INTERVAL-month period counted from drawdown\n        if m > loan_month and (m - loan_month) % pay_interval == 0:\n            accrued = Q(0)\n\n    total = insurance_expense + interest_expense\n    return {\n        \"final\": total,\n        \"prepaid_insurance_asset\": prepaid,\n        \"accrued_interest_liability\": accrued,\n        \"insurance_expense\": insurance_expense,\n    }\n",
