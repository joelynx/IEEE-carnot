 "program": "def solve():\n    cogs = Q(P[\"COGS\"])\n    inv_o, inv_c = Q(P[\"INV_OPEN\"]), Q(P[\"INV_CLOSE\"])\n    ap_o, ap_c = Q(P[\"AP_OPEN\"]), Q(P[\"AP_CLOSE\"])\n    adv_o, adv_c = Q(P[\"ADV_OPEN\"]), Q(P[\"ADV_CLOSE\"])\n    share = Q(P[\"SHARE_SETTLE\"])\n\n    # Inventory ledger: opening + purchases - COGS = closing\n    purchases = inv_c - cogs * 0 + cogs - inv_o  # = COGS + closing - opening\n    purchases = cogs + inv_c - inv_o\n\n    # Payables ledger: opening + purchases(on credit) - share settlements - cash settlements = closing\n    cash_settle_payables = ap_o + purchases - share - ap_c\n    payables_change = ap_c - ap_o\n\n    # Advances ledger: opening + cash advances paid - advances applied = closing\n    # Advances applied against purchases reduce the payable without cash, so net cash effect\n    # of advances is the change in the advance balance (cash out to build the balance).\n    cash_advances_net = adv_c - adv_o\n\n    cash_paid = cash_settle_payables + cash_advances_net\n\n    # Net supplier working capital\n    nwc_open = inv_o + adv_o - ap_o\n    nwc_close = inv_c + adv_c - ap_c\n    net_wc_change = nwc_close - nwc_open\n\n    if cash_paid < 0:\n        raise ValueError(\"Implied cash paid to suppliers is negative; data inconsistent\")\n\n    return {\n        \"final\": cash_paid,\n        \"purchases\": purchases,\n        \"payables_change\": payables_change,\n        \"net_wc_change\": net_wc_change,\n    }\n",
