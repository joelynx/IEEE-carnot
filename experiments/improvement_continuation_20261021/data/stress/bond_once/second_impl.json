 "program": "def solve():\n    face = Q(P[\"FACE\"])\n    a1 = face * Q(P[\"A1_PCT\"]) / 100\n    a2 = face * Q(P[\"A2_PCT\"]) / 100\n    c1 = Q(P[\"C1_PCT\"]) / 100\n    c2 = c1 + Q(P[\"STEP_BP\"]) / 10000\n    y = Q(P[\"Y_PCT\"]) / 100\n    call_rate = Q(P[\"CALL_PCT\"]) / 100\n    days = Q(P[\"DAYS\"])\n\n    # Period-by-period ledger of principal outstanding and cash flows\n    outstanding = face\n    rates = {1: c1, 2: c2, 3: c2}\n    flows = {}\n    # Year 1\n    coupon1 = rates[1] * outstanding\n    outstanding -= a1\n    flows[1] = coupon1 + a1\n    # Year 2\n    coupon2 = rates[2] * outstanding\n    outstanding -= a2\n    scheduled2 = coupon2 + a2\n    p2 = outstanding\n    if p2 < 0:\n        raise ValueError(\"installments exceed face\")\n    # Year 3 (scheduled)\n    coupon3 = rates[3] * p2\n    flow3 = coupon3 + p2\n\n    pv3_at_2 = flow3 / (1 + y)\n    call_payment = call_rate * p2\n    called = call_payment < pv3_at_2\n    decision = \"call\" if called else \"no_call\"\n\n    if called:\n        flows[2] = scheduled2 + call_payment\n    else:\n        flows[2] = scheduled2\n        flows[3] = flow3\n    year2_total = flows[2]\n\n    def disc(k):\n        t = Q(k) - days / 360\n        return exp(-t * ln(1 + y))\n\n    price = sum(cf * disc(k) for k, cf in flows.items())\n\n    return {\n        \"final\": price,\n        \"principal_after_year2\": p2,\n        \"pv_year3_at_year2\": pv3_at_2,\n        \"call_decision\": decision,\n        \"year2_total_received\": year2_total,\n    }\n",
