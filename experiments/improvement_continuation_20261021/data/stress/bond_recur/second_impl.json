 "program": "def solve():\n    from fractions import Fraction\n    from decimal import Decimal, getcontext\n    getcontext().prec = 60\n\n    F = Fraction(P[\"FACE\"])\n    a1p = Fraction(P[\"A1_PCT\"])\n    a2p = Fraction(P[\"A2_PCT\"])\n    c1p = Fraction(P[\"C1_PCT\"])\n    step_bp = Fraction(P[\"STEP_BP\"])\n    yp = Fraction(P[\"Y_PCT\"])\n    callp = Fraction(P[\"CALL_PCT\"])\n    days = Fraction(P[\"DAYS\"])\n\n    # Principal schedule (ledger)\n    A1 = F * a1p / 100\n    A2 = F * a2p / 100\n    bal0 = F\n    bal1 = bal0 - A1          # outstanding during year 2\n    bal2 = bal1 - A2          # outstanding during year 3 (remaining balance)\n    A3 = bal2\n    if A3 < 0:\n        raise ValueError(\"installments exceed face\")\n\n    # Coupon rates by year\n    c1 = c1p / 100\n    c2 = c1 + step_bp / 10000\n    c3 = c2 + step_bp / 10000\n    y = yp / 100\n\n    cf1 = c1 * bal0 + A1\n    cf2 = c2 * bal1 + A2\n    cf3 = c3 * bal2 + A3\n\n    call_payment = callp / 100 * bal2\n    pv3_at2 = cf3 / (1 + y)\n    called = call_payment < pv3_at2\n    decision = \"call\" if called else \"no_call\"\n\n    year2_total = cf2 + (call_payment if called else Fraction(0))\n\n    def to_dec(fr):\n        return Decimal(fr.numerator) / Decimal(fr.denominator)\n\n    base = to_dec(1 + y)\n\n    def df(k):\n        t = Fraction(k) - days / 360\n        return base ** (-to_dec(t))\n\n    price = to_dec(cf1) * df(1) + to_dec(year2_total) * df(2)\n    if not called:\n        price += to_dec(cf3) * df(3)\n\n    return {\n        \"final\": price,\n        \"principal_after_year2\": bal2,\n        \"pv_year3_at_year2\": pv3_at2,\n        \"call_decision\": decision,\n        \"year2_total_received\": year2_total,\n    }\n",
