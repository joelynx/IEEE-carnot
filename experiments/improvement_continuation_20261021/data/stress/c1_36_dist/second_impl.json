 "program": "def solve():\n    from decimal import Decimal, getcontext\n    getcontext().prec = 60\n\n    y1 = Fraction(P[\"Y1\"]) / 100\n    y2 = Fraction(P[\"Y2\"]) / 100\n    y3 = Fraction(P[\"Y3\"]) / 100\n    spread = Fraction(P[\"SPREAD_BP\"]) / 10000\n    face = Fraction(P[\"FACE\"])\n\n    # Bootstrap discount factors exactly (par bond worth face at each maturity)\n    d1 = 1 / (1 + y1)\n    d2 = (1 - y2 * d1) / (1 + y2)\n    if d2 <= 0:\n        raise ValueError(\"two-year discount factor not positive\")\n    d3 = (1 - y3 * (d1 + d2)) / (1 + y3)\n    if d3 <= 0:\n        raise ValueError(\"three-year discount factor not positive\")\n\n    def to_dec(fr):\n        return Decimal(fr.numerator) / Decimal(fr.denominator)\n\n    D2 = to_dec(d2)\n    D3 = to_dec(d3)\n    # effective annual zero rates: (1+z_t)^t = 1/d_t\n    z2 = (Decimal(1) / D2).sqrt() - 1\n    z3 = (Decimal(1) / D3) ** (Decimal(1) / Decimal(3)) - 1\n    # forward: (1+f) = (1+z3)^3/(1+z2)^2 = d2/d3 exactly\n    fwd = d2 / d3 - 1\n\n    # Bond coupon rate: 3y par yield plus spread, floored at zero\n    c = y3 + spread\n    if c < 0:\n        c = Fraction(0)\n    coupon = face * c\n    price = coupon * d1 + coupon * d2 + (coupon + face) * d3\n\n    return {\n        \"final\": to_dec(price),\n        \"two_year_zero_rate\": z2 * 100,\n        \"three_year_zero_rate\": z3 * 100,\n        \"forward_rate_2y1y\": to_dec(fwd) * 100,\n    }\n",
