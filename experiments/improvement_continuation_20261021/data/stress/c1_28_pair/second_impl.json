 "program": "def solve():\n    gross = Q(P[\"GROSS_T1\"])\n    goodwill = Q(P[\"GOODWILL\"])\n    dta = Q(P[\"DTA\"])\n    thresh_pct = Q(P[\"DTA_THRESH_PCT\"])\n    on_bs = Q(P[\"ON_BS\"])\n    undrawn = Q(P[\"UNDRAWN\"])\n    ccf_pct = Q(P[\"CCF_PCT\"])\n    min_pct = Q(P[\"MIN_PCT\"])\n\n    # Deductions ledger\n    deductions = []\n    deductions.append(goodwill)\n    threshold_amount = gross * thresh_pct / 100\n    if dta > threshold_amount:\n        deductions.append(dta)\n    else:\n        deductions.append(Q(0))\n\n    tier1 = gross\n    for d in deductions:\n        tier1 = tier1 - d\n\n    if tier1 <= 0:\n        raise ValueError(\"Tier 1 capital after deductions is zero or negative\")\n\n    # Exposure measure ledger\n    exposure_items = [on_bs, undrawn * ccf_pct / 100]\n    exposure = Q(0)\n    for e in exposure_items:\n        exposure = exposure + e\n\n    ratio_pct = tier1 / exposure * 100\n\n    # Shortfall: capital needed so that (tier1 + x) / exposure * 100 == min_pct\n    required_capital = min_pct / 100 * exposure\n    shortfall = required_capital - tier1\n    if shortfall < 0:\n        shortfall = Q(0)\n\n    return {\n        \"final\": shortfall,\n        \"tier1_after_deductions\": tier1,\n        \"exposure_measure\": exposure,\n        \"leverage_ratio_percent\": ratio_pct,\n    }\n",
