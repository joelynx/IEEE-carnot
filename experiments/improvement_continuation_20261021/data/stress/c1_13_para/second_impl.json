 "program": "def solve():\n    D0 = Q(P[\"D0\"])\n    g1 = Q(P[\"G1_BP\"]) / 10000\n    N = int(P[\"N_Q\"])\n    G2 = Q(P[\"G2_PCT\"]) / 100\n    R = Q(P[\"R_EFF\"]) / 100\n    conv = P[\"CONV\"]\n\n    # effective annual -> compounded quarterly\n    q = exp(ln(1 + R) / 4) - 1\n\n    # stage-two quarterly growth per convention\n    if conv == \"compound\":\n        g2q = exp(ln(1 + G2) / 4) - 1\n    elif conv == \"nominal\":\n        g2q = G2 / 4\n    else:\n        raise ValueError(\"unknown convention\")\n\n    # period-by-period ledger for stage one\n    div = D0\n    disc = 1\n    pv1 = 0\n    for t in range(1, N + 1):\n        div = div * (1 + g1)\n        disc = disc * (1 + q)\n        pv1 = pv1 + div / disc\n    # after loop: div = D_N, disc = (1+q)^N\n\n    if not (g2q < q):\n        raise ValueError(\"stage-two growth must be lower than the quarterly rate\")\n\n    d_next = div * (1 + g2q)\n    tv = d_next / (q - g2q)\n    price = pv1 + tv / disc\n\n    return {\n        \"final\": price,\n        \"quarterly_rate\": q * 100,\n        \"stage_one_pv\": pv1,\n        \"terminal_value\": tv,\n    }\n",
