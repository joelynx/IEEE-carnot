 "program": "def solve():\n    cogs = Q(P[\"COGS\"])\n    inv_open = Q(P[\"INV_OPEN\"])\n    inv_close = Q(P[\"INV_CLOSE\"])\n    ap_open = Q(P[\"AP_OPEN\"])\n    ap_close = Q(P[\"AP_CLOSE\"])\n    adv_open = Q(P[\"ADV_OPEN\"])\n    adv_close = Q(P[\"ADV_CLOSE\"])\n    share_settle = Q(P[\"SHARE_SETTLE\"])\n\n    # Inventory ledger: opening + purchases - COGS = closing (no write-downs)\n    purchases = cogs + inv_close - inv_open\n\n    # Trade payables change (closing minus opening)\n    payables_change = ap_close - ap_open\n\n    # Net supplier working capital = inventory + advances - payables\n    nwc_open = inv_open + adv_open - ap_open\n    nwc_close = inv_close + adv_close - ap_close\n    net_wc_change = nwc_close - nwc_open\n\n    # Ledger reconstruction of cash flows to suppliers.\n    # Drawdowns of advances against purchases reduce payables and advances alike;\n    # their amount does not affect total cash, so model with an arbitrary drawdown d.\n    # Payables: ap_open + purchases - share_settle - d - cash_settle = ap_close\n    # Advances: adv_open + cash_adv - d = adv_close\n    d = Q(0)\n    cash_settle = ap_open + purchases - share_settle - d - ap_close\n    cash_adv = adv_close - adv_open + d\n    cash_paid = cash_settle + cash_adv\n\n    # Store rent is not a supplier payment; excluded.\n    if cash_paid < 0:\n        raise ValueError(\"Implied cash paid to suppliers is negative; data inconsistent\")\n\n    return {\n        \"final\": cash_paid,\n        \"purchases\": purchases,\n        \"payables_change\": payables_change,\n        \"net_wc_change\": net_wc_change,\n    }\n",
