 "program": "def solve():\n    y1 = P[\"Y1\"] / 100\n    y2 = P[\"Y2\"] / 100\n    y3 = P[\"Y3\"] / 100\n    face = P[\"FACE\"]\n    spread = P[\"SPREAD_BP\"]\n\n    # Bootstrap via discount factors: par bond with coupon c maturing at n\n    # satisfies c * sum(d_1..d_{n-1}) + (1 + c) * d_n = 1.\n    dfs = []\n    pars = [y1, y2, y3]\n    for n, c in enumerate(pars, start=1):\n        annuity = sum(dfs)  # discount factors for years 1..n-1\n        d_n = (1 - c * annuity) / (1 + c)\n        if d_n <= 0:\n            raise ValueError(\"Par yields inconsistent with positive discount factors\")\n        dfs.append(d_n)\n    d1, d2, d3 = dfs\n\n    # Effective annual zero rates from discount factors\n    z2 = sqrt(1 / d2) - 1\n    z3 = exp(-ln(d3) / 3) - 1\n\n    # Forward 2y1y: (1+z2)^2 (1+f) = (1+z3)^3  ->  1+f = d2/d3\n    f = d2 / d3 - 1\n\n    # Bond coupon rate: three-year par yield plus spread, floored at zero\n    c = y3 + Q(spread, 10000)\n    if c < 0:\n        c = Q(0)\n\n    # Cash-flow ledger discounted at zero rates (equivalently discount factors)\n    cashflows = [\n        (1, face * c),\n        (2, face * c),\n        (3, face * c + face),\n    ]\n    price = 0\n    for t, cf in cashflows:\n        price += cf * dfs[t - 1]\n\n    return {\n        \"final\": price,\n        \"two_year_zero_rate\": z2 * 100,\n        \"three_year_zero_rate\": z3 * 100,\n        \"forward_rate_2y1y\": f * 100,\n    }\n",
