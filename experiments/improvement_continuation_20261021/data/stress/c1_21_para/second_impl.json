 "program": "def solve():\n    supply_tokens = Q(P[\"SUPPLY\"]) * 1000000\n    bal_pct = Q(P[\"BAL_PCT\"])\n    out_thresh = Q(P[\"OUT_THRESH\"])\n    cold = P[\"COLD\"]\n\n    addresses = {\n        \"A\": (Q(P[\"BAL_A\"]), Q(20000)),\n        \"B\": (Q(P[\"BAL_B\"]), Q(P[\"OUT_B\"])),\n        \"C\": (Q(P[\"BAL_C\"]), Q(0)),\n    }\n\n    balance_threshold = supply_tokens * bal_pct / 100\n\n    whale_count = 0\n    total_whale_balance = Q(0)\n    for name in (\"A\", \"B\", \"C\"):\n        bal, out = addresses[name]\n        if name == cold:\n            continue\n        by_balance = bal > balance_threshold\n        by_outflow = out > out_thresh\n        if by_balance or by_outflow:\n            whale_count += 1\n            total_whale_balance += bal\n\n    share = total_whale_balance / supply_tokens * 100\n\n    return {\n        \"final\": share,\n        \"balance_threshold\": balance_threshold,\n        \"whale_count\": Q(whale_count),\n        \"total_whale_balance\": total_whale_balance,\n    }\n",
