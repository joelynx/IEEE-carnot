 "program": "def solve():\n    face = Q(P[\"FACE\"])\n    a1 = Q(P[\"A1_PCT\"]) / 100 * face\n    a2 = Q(P[\"A2_PCT\"]) / 100 * face\n    c1 = Q(P[\"C1_PCT\"]) / 100\n    c2 = c1 + Q(P[\"STEP_BP\"]) / 10000\n    y = Q(P[\"Y_PCT\"]) / 100\n    call_rate = Q(P[\"CALL_PCT\"]) / 100\n    t = Q(P[\"DAYS\"]) / 360\n\n    # Period-by-period ledger of principal outstanding\n    bal0 = face                    # outstanding during year 1\n    cf1 = c1 * bal0 + a1\n    bal1 = bal0 - a1               # outstanding during year 2\n    cf2_sched = c2 * bal1 + a2\n    bal2 = bal1 - a2               # outstanding during year 3 (after year-2 installment)\n    cf3 = c2 * bal2 + bal2\n\n    pv3_at_2 = cf3 / (1 + y)\n    call_payment = call_rate * bal2\n    called = call_payment < pv3_at_2\n\n    year2_total = cf2_sched + (call_payment if called else 0)\n\n    def df(k):\n        return exp(-(Q(k) - t) * ln(1 + y))\n\n    price = cf1 * df(1) + year2_total * df(2)\n    if not called:\n        price += cf3 * df(3)\n\n    return {\n        \"final\": price,\n        \"principal_after_year2\": bal2,\n        \"pv_year3_at_year2\": pv3_at_2,\n        \"call_decision\": \"call\" if called else \"no_call\",\n        \"year2_total_received\": year2_total,\n    }\n",
