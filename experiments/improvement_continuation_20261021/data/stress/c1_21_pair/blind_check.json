        "code": "def solve():\n    supply = 190000000\n    addrs = {\n        \"A\": (1000000, 20000),\n        \"B\": (1900000, 550000),\n        \"C\": (2000000, 0),\n    }\n    combined = sum(b for b, _ in addrs.values())\n    balance_threshold = Q(3, 100) * combined\n    outflow_threshold = 600000\n    cold = set()\n    flagged = []\n    for name, (bal, out) in addrs.items():\n        if name in cold:\n            continue\n        if bal > balance_threshold or out > outflow_threshold:\n            flagged.append(name)\n    total_whale_balance = sum(addrs[n][0] for n in flagged)\n    final = Q(total_whale_balance, supply) * 100\n    return {\n        \"final\": final,\n        \"balance_threshold\": balance_threshold,\n        \"whale_count\": len(flagged),\n        \"total_whale_balance\": total_whale_balance,\n    }\n",
