 "program": "def solve():\n    supply_tokens = Q(P[\"SUPPLY\"]) * 1000000\n    bal_pct = Q(P[\"BAL_PCT\"])\n    out_thresh = Q(P[\"OUT_THRESH\"])\n    cold = P[\"COLD\"]\n\n    addresses = {\n        \"A\": (Q(P[\"BAL_A\"]), Q(20000)),\n        \"B\": (Q(P[\"BAL_B\"]), Q(P[\"OUT_B\"])),\n        \"C\": (Q(P[\"BAL_C\"]), Q(0)),\n    }\n\n    combined = sum(bal for bal, _ in addresses.values())\n    balance_threshold = combined * bal_pct / 100\n\n    flagged = []\n    for name, (bal, out) in addresses.items():\n        if name == cold:\n            continue\n        by_balance = bal > balance_threshold\n        by_outflow = out > out_thresh\n        if by_balance or by_outflow:\n            flagged.append(name)\n\n    total_whale_balance = sum(addresses[n][0] for n in flagged) if flagged else Q(0)\n    whale_count = Q(len(flagged))\n    share_pct = total_whale_balance / supply_tokens * 100\n\n    return {\n        \"final\": share_pct,\n        \"balance_threshold\": balance_threshold,\n        \"whale_count\": whale_count,\n        \"total_whale_balance\": total_whale_balance,\n    }\n",
