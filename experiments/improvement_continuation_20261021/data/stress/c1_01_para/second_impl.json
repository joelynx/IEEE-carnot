 "program": "def solve():\n    premium = Q(P[\"PREMIUM\"])\n    policy_months = int(P[\"POLICY_MONTHS\"])\n    start_month = int(P[\"START_MONTH\"])\n    principal = Q(P[\"PRINCIPAL\"])\n    rate = Q(P[\"RATE\"]) / 100\n    loan_month = int(P[\"LOAN_MONTH\"])\n    pay_interval = int(P[\"PAY_INTERVAL\"])\n\n    # --- Insurance ledger: month-by-month amortisation of the prepaid balance ---\n    monthly_ins = premium / policy_months\n    prepaid = Q(0)\n    insurance_expense = Q(0)\n    months_remaining = 0\n    for m in range(1, 13):\n        if m == start_month:\n            prepaid += premium\n            months_remaining = policy_months\n        if months_remaining > 0:\n            insurance_expense += monthly_ins\n            prepaid -= monthly_ins\n            months_remaining -= 1\n\n    # --- Loan ledger: accrue monthly, settle at the close of each interval ---\n    monthly_int = principal * rate / 12\n    accrued = Q(0)\n    interest_expense = Q(0)\n    elapsed = 0\n    borrowed = False\n    for m in range(1, 13):\n        if m == loan_month:\n            borrowed = True\n        if borrowed:\n            accrued += monthly_int\n            interest_expense += monthly_int\n            elapsed += 1\n            if elapsed % pay_interval == 0:\n                # cash settlement in arrears at the close of this month\n                accrued = Q(0)\n\n    total = insurance_expense + interest_expense\n    return {\n        \"final\": total,\n        \"prepaid_insurance_asset\": prepaid,\n        \"accrued_interest_liability\": accrued,\n        \"insurance_expense\": insurance_expense,\n    }\n",
