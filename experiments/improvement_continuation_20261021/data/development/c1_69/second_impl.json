 "program": "def solve():\n    price = Q(P[\"PURCHASE_PRICE\"])\n    claims = [Q(P[\"CLAIM_A\"]), Q(P[\"CLAIM_B\"]), Q(P[\"CLAIM_C\"])]\n    de_min = Q(P[\"DE_MINIMIS\"])\n    basket = Q(P[\"BASKET\"])\n    cap_pct = Q(P[\"CAP_PCT\"])\n    btype = P[\"BASKET_TYPE\"]\n\n    # Step 1: per-claim de minimis screen (ledger over claims)\n    eligible_total = Q(0)\n    for c in claims:\n        if c < de_min:\n            continue  # disregarded entirely\n        eligible_total += c\n\n    # Step 2: basket rule\n    if eligible_total > basket:\n        if btype == \"deductible\":\n            recoverable = eligible_total - basket\n        elif btype == \"tipping\":\n            recoverable = eligible_total\n        else:\n            raise ValueError(\"unknown basket type\")\n    else:\n        recoverable = Q(0)\n\n    # Step 3: cap\n    cap_amount = price * cap_pct / 100\n    final = recoverable if recoverable <= cap_amount else cap_amount\n\n    return {\n        \"final\": final,\n        \"eligible_claims_total\": eligible_total,\n        \"recoverable_before_cap\": recoverable,\n        \"cap_amount\": cap_amount,\n    }\n",
