 "program": "def solve():\n    R_A = Q(P[\"R_A\"])\n    R_U = Q(P[\"R_U\"])\n    direction = P[\"DIRECTION\"]\n    trade_pct = Q(P[\"TRADE_PCT\"])\n    fee_bps = Q(P[\"FEE_BPS\"])\n    shock = Q(P[\"SHOCK\"])\n\n    # Pre-trade invariant and spot\n    k = R_A * R_U\n    spot = R_U / R_A\n    benchmark = spot * (1 + shock / 100)\n\n    if direction == \"sell_a\":\n        in_res, out_res = R_A, R_U\n    elif direction == \"buy_a\":\n        in_res, out_res = R_U, R_A\n    else:\n        raise ValueError(\"unknown direction\")\n\n    gross = in_res * trade_pct / 100\n    fee = gross * fee_bps / 10000\n    net = gross - fee\n\n    # Invariant-based output: new output reserve = k / (in_res + net)\n    new_out_res = k / (in_res + net)\n    out_amt = out_res - new_out_res\n    if out_amt <= 0:\n        raise ValueError(\"no output\")\n\n    post_input_reserve = in_res + gross  # fee stays in pool\n\n    if direction == \"sell_a\":\n        effective = out_amt / gross          # USD out per A in\n        result = out_amt - gross * benchmark\n    else:\n        effective = gross / out_amt          # USD in per A out\n        result = out_amt * benchmark - gross\n\n    price_impact = (effective / spot - 1) * 100\n\n    return {\n        \"final\": result,\n        \"output_amount\": out_amt,\n        \"post_input_reserve\": post_input_reserve,\n        \"price_impact\": price_impact,\n    }\n",
