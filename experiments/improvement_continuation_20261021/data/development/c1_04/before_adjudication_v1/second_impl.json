 "program": "def solve():\n    cogs = P[\"COGS\"]\n    inv_o, inv_c = P[\"INV_OPEN\"], P[\"INV_CLOSE\"]\n    ap_o, ap_c = P[\"AP_OPEN\"], P[\"AP_CLOSE\"]\n    adv_o, adv_c = P[\"ADV_OPEN\"], P[\"ADV_CLOSE\"]\n    share = P[\"SHARE_SETTLE\"]\n\n    # Inventory ledger: opening + purchases - COGS = closing\n    purchases = cogs + inv_c - inv_o\n\n    # Payables and advances ledgers (advances applied against purchases cancels out)\n    # Payables: ap_o + purchases - share - applied - cash_on_payables = ap_c\n    # Advances: adv_o + advances_paid - applied = adv_c\n    # Treat \"applied\" as an arbitrary quantity; it nets to zero in total cash paid.\n    applied = 0\n    cash_on_payables = ap_o + purchases - share - applied - ap_c\n    advances_paid = adv_c - adv_o + applied\n    cash_paid = cash_on_payables + advances_paid\n\n    payables_change = ap_c - ap_o\n    net_wc_open = inv_o + adv_o - ap_o\n    net_wc_close = inv_c + adv_c - ap_c\n    net_wc_change = net_wc_close - net_wc_open\n\n    # Consistency check with the working-capital identity\n    assert cash_paid == cogs + net_wc_change - share\n\n    if cash_paid < 0:\n        raise ValueError(\"Implied cash paid to suppliers is negative; data inconsistent\")\n\n    return {\n        \"final\": cash_paid,\n        \"purchases\": purchases,\n        \"payables_change\": payables_change,\n        \"net_wc_change\": net_wc_change,\n    }\n",
