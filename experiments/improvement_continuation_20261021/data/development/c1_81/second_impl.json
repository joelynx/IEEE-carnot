 "program": "def solve():\n    B = Q(P[\"B\"])\n    U = Q(P[\"U\"])\n    D = Q(P[\"D\"])\n    C = Q(P[\"C\"])\n    PU = Q(P[\"PU\"])\n    PD = Q(P[\"PD\"])\n\n    PB = 100 - PU - PD\n    if PB <= 0:\n        raise ValueError(\"Base-case probability must be strictly positive\")\n\n    # Scenario values\n    upside_value = B * (1 + U / 100)\n    downside_value = B * (1 - D / 100) - C\n    base_value = B\n\n    # Enumerate scenarios as (probability, value) ledger\n    scenarios = [\n        (PU / 100, upside_value),\n        (PD / 100, downside_value),\n        (PB / 100, base_value),\n    ]\n    expected_value = 0\n    for prob, val in scenarios:\n        expected_value += prob * val\n\n    downside_loss = base_value - downside_value\n    incremental = expected_value - base_value\n\n    return {\n        \"final\": incremental,\n        \"base_probability\": PB,\n        \"expected_value\": expected_value,\n        \"downside_loss\": downside_loss,\n    }\n",
