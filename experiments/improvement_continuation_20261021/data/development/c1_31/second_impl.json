 "program": "def solve():\n    loss = Q(P[\"LOSS\"])\n    recovery = Q(P[\"RECOVERY\"])\n    fee_pct = Q(P[\"FEE_PCT\"])\n    ded = Q(P[\"DEDUCTIBLE\"])\n    tier = Q(P[\"TIER_BREAK\"])\n    c_low = Q(P[\"COINS_LOW\"]) / 100\n    c_high = Q(P[\"COINS_HIGH\"]) / 100\n    sub = Q(P[\"SUBLIMIT\"])\n\n    def apply_terms(insured):\n        # (1) deductible, floored at zero\n        rem = insured - ded\n        if rem < 0:\n            rem = Q(0)\n        # (2) marginal coinsurance: enumerate two tiers explicitly\n        in_low = rem if rem <= tier else tier\n        in_high = rem - in_low\n        pay = c_low * in_low + c_high * in_high\n        # (3) sublimit\n        if pay > sub:\n            pay = sub\n        return pay\n\n    fee = recovery * fee_pct / 100\n    net_rec = recovery - fee\n    if net_rec > loss:\n        raise ValueError(\"net recovery exceeds gross loss; claim invalid\")\n\n    insured_loss = loss - net_rec\n    payment = apply_terms(insured_loss)\n    retained = insured_loss - payment\n    if retained < 0:\n        retained = -retained\n\n    bench_pay = apply_terms(loss)\n    bench_retained = loss - bench_pay\n    if bench_retained < 0:\n        bench_retained = -bench_retained\n\n    change = retained - bench_retained\n\n    return {\n        \"final\": change,\n        \"net_recovery\": net_rec,\n        \"insurer_payment\": payment,\n        \"retained_loss\": retained,\n        \"benchmark_payment\": bench_pay,\n    }\n",
