 "program": "def solve():\n    from fractions import Fraction as F\n    from decimal import Decimal, getcontext\n    getcontext().prec = 60\n\n    y1 = F(P[\"Y1\"]) / 100\n    y2 = F(P[\"Y2\"]) / 100\n    y3 = F(P[\"Y3\"]) / 100\n    spread_bp = F(P[\"SPREAD_BP\"])\n    face = F(P[\"FACE\"])\n\n    # Bootstrap discount factors exactly, maturity by maturity.\n    # Par bond at maturity n: c_n * sum(d_1..d_n) + d_n = 1\n    dfs = []\n    for y in (y1, y2, y3):\n        s = sum(dfs)\n        denom = 1 + y\n        if denom <= 0:\n            raise ValueError(\"invalid par yield\")\n        d = (1 - y * s) / denom\n        if d <= 0:\n            raise ValueError(\"inconsistent par curve: non-positive discount factor\")\n        dfs.append(d)\n    d1, d2, d3 = dfs\n\n    def to_dec(fr):\n        return Decimal(fr.numerator) / Decimal(fr.denominator)\n\n    # Zero rates: (1+z_t)^t = 1/d_t\n    z2 = to_dec(1 / d2) ** (Decimal(1) / Decimal(2)) - 1\n    z3 = to_dec(1 / d3) ** (Decimal(1) / Decimal(3)) - 1\n    # Forward: (1+f) = (1+z3)^3/(1+z2)^2 = d2/d3 (exact rational)\n    f_rate = d2 / d3 - 1\n\n    # Bond coupon: three-year par yield plus spread, floored at zero\n    coupon_rate = y3 + spread_bp / 10000\n    if coupon_rate < 0:\n        coupon_rate = F(0)\n    coupon = face * coupon_rate\n\n    # Price by cash-flow ledger\n    cashflows = [(1, coupon), (2, coupon), (3, coupon + face)]\n    price = F(0)\n    for t, cf in cashflows:\n        price += cf * dfs[t - 1]\n\n    return {\n        \"final\": price,\n        \"two_year_zero_rate\": z2 * 100,\n        \"three_year_zero_rate\": z3 * 100,\n        \"forward_rate_2y1y\": f_rate * 100,\n    }\n",
