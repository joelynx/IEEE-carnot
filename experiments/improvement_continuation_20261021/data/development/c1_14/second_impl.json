 "program": "def solve():\n    VU = Q(P[\"VU\"])\n    EBIT0 = Q(P[\"EBIT0\"])\n    REV = Q(P[\"REV\"])\n    TAX = Q(P[\"TAX\"]) / 100\n    STEP = Q(P[\"STEP\"])\n    R0 = Q(P[\"R0\"]) / 100\n    DC = Q(P[\"DC\"]) / 100\n    MULT = Q(P[\"MULT\"])\n\n    adj_ebit = EBIT0 + REV\n    threshold = MULT * adj_ebit\n\n    # Enumerate every grid level explicitly\n    levels = []\n    for k in range(0, 5):\n        debt = k * STEP\n        if k == 0:\n            rate = Q(0)\n            interest = Q(0)\n            admissible = True\n        else:\n            rate = R0 + Q(k - 1) / 100\n            interest = debt * rate\n            admissible = interest <= adj_ebit\n        excess = debt - threshold\n        if excess < 0:\n            excess = Q(0)\n        value = VU + TAX * debt - DC * excess\n        levels.append((k, debt, admissible, value))\n\n    admissible_levels = [lv for lv in levels if lv[2]]\n    highest_adm_debt = max(lv[1] for lv in admissible_levels)\n\n    # Choose highest value; ties to the lower debt (scan ascending, replace only on strict improvement)\n    chosen = None\n    for lv in admissible_levels:\n        if chosen is None or lv[3] > chosen[3]:\n            chosen = lv\n\n    chosen_debt = chosen[1]\n    chosen_value = chosen[3]\n    equity = chosen_value - chosen_debt\n\n    return {\n        \"final\": equity,\n        \"adjusted_ebit\": adj_ebit,\n        \"highest_admissible_debt\": highest_adm_debt,\n        \"chosen_debt\": chosen_debt,\n        \"chosen_firm_value\": chosen_value,\n    }\n",
