        "code": "def solve():\n    V_u = Q(630)\n    ebit = Q(115) + Q(10)\n    t = Q(\"0.31\")\n    unit = Q(60)\n    threshold = 2 * ebit\n    levels = []\n    for k in range(0, 5):\n        debt = k * unit\n        if k == 0:\n            admissible = True\n        else:\n            rate = Q(\"0.08\") + Q(\"0.01\") * (k - 1)\n            admissible = debt * rate <= ebit\n        if not admissible:\n            continue\n        excess = debt - threshold\n        if excess < 0:\n            excess = Q(0)\n        fv = V_u + t * debt - Q(\"0.20\") * excess\n        levels.append((debt, fv))\n    highest_adm = max(d for d, _ in levels)\n    chosen_debt, chosen_fv = levels[0]\n    for d, fv in levels:\n        if fv > chosen_fv:\n            chosen_debt, chosen_fv = d, fv\n    equity = chosen_fv - chosen_debt\n    return {\n        \"final\": equity,\n        \"adjusted_ebit\": ebit,\n        \"highest_admissible_debt\": highest_adm,\n        \"chosen_debt\": chosen_debt,\n        \"chosen_firm_value\": chosen_fv,\n    }\n",
