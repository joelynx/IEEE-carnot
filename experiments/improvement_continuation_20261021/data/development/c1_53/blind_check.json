        "code": "def solve():\n    balance = Q(9000)\n    months = 30\n    deposit = Q(800)\n    annual_return = Q(\"0.06\")\n    fee = Q(\"0.0025\")\n    r = (annual_return - fee) / 12\n    one_time = Q(-4500)\n    one_time_month = 24\n    goal = Q(71000)\n\n    bal = balance\n    for m in range(1, months + 1):\n        bal = bal * (1 + r) + deposit\n        if m == one_time_month:\n            bal += one_time\n    projected = bal\n    gap = projected - goal\n\n    # annuity factor for level additional monthly deposit at end of each month\n    af = sum((1 + r) ** (months - m) for m in range(1, months + 1))\n    if gap < 0:\n        add = -gap / af\n    else:\n        add = Q(0)\n\n    return {\n        \"final\": add,\n        \"net_monthly_rate_pct\": r * 100,\n        \"projected_value\": projected,\n        \"signed_gap\": gap,\n    }\n",
