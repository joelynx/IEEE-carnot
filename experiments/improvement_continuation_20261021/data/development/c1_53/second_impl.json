 "program": "def solve():\n    start = Q(P[\"START\"])\n    contrib = Q(P[\"CONTRIB\"])\n    annual_ret = Q(P[\"ANNUAL_RET\"])\n    fee_bps = Q(P[\"FEE_BPS\"])\n    months = int(P[\"MONTHS\"])\n    lump = Q(P[\"LUMP\"])\n    lump_month = int(P[\"LUMP_MONTH\"])\n    goal = Q(P[\"GOAL\"])\n\n    # net monthly rate (as a fraction)\n    annual_fee_pct = fee_bps / 100\n    r = (annual_ret - annual_fee_pct) / 100 / 12\n    net_monthly_rate_pct = r * 100\n\n    # Month-by-month ledger: grow at start-of-month balance, then deposit, then lump if applicable.\n    bal = start\n    # Also track the sensitivity: value at goal date per 1 USD of extra level deposit each month\n    sens = Q(0)\n    for m in range(1, months + 1):\n        bal = bal * (1 + r)\n        sens = sens * (1 + r)\n        bal = bal + contrib\n        sens = sens + 1\n        if m == lump_month:\n            bal = bal + lump\n\n    projected = bal\n    gap = projected - goal\n\n    if gap < 0:\n        extra = (goal - projected) / sens\n    else:\n        extra = Q(0)\n\n    return {\n        \"final\": extra,\n        \"net_monthly_rate_pct\": net_monthly_rate_pct,\n        \"projected_value\": projected,\n        \"signed_gap\": gap,\n    }\n",
