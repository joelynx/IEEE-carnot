 "program": "def solve():\n    r = Q(P[\"RATE\"], 100)\n    inv_a = Q(P[\"INV_A\"]); cf_a = Q(P[\"CF_A\"]); life_a = int(P[\"LIFE_A\"]); term_a = Q(P[\"TERM_A\"])\n    inv_b = Q(P[\"INV_B\"]); life_b = int(P[\"LIFE_B\"]); dcost_b = Q(P[\"DCOST_B\"])\n\n    # Build explicit year-by-year cash-flow ledgers\n    flows_a = {0: -inv_a}\n    for t in range(1, life_a + 1):\n        flows_a[t] = cf_a\n    flows_a[life_a] += term_a\n\n    annual_b = -dcost_b  # cost reduction (negative) -> inflow; cost increase -> outflow\n    flows_b = {0: -inv_b}\n    for t in range(1, life_b + 1):\n        flows_b[t] = annual_b\n\n    def npv(flows):\n        total = Q(0)\n        for t, cf in flows.items():\n            total += cf / (1 + r) ** t\n        return total\n\n    npv_a = npv(flows_a)\n    npv_b = npv(flows_b)\n\n    def annuity_factor(n):\n        # PV of 1 per year for n years, computed as explicit sum\n        return sum(1 / (1 + r) ** t for t in range(1, n + 1))\n\n    eaa_a = npv_a / annuity_factor(life_a)\n    eaa_b = npv_b / annuity_factor(life_b)\n    eaa_larger = eaa_a if eaa_a >= eaa_b else eaa_b\n\n    if npv_a <= 0 and npv_b <= 0:\n        final = \"neither\"\n    elif eaa_a >= eaa_b:\n        final = \"project_a\"\n    else:\n        final = \"project_b\"\n\n    return {\n        \"final\": final,\n        \"npv_a\": npv_a,\n        \"npv_b\": npv_b,\n        \"eaa_larger\": eaa_larger,\n    }\n",
