 "program": "def solve():\n    capex = Q(P[\"CAPEX\"])\n    eq_ratio = Q(P[\"EQUITY_RATIO\"]) / 100\n    base_ni = Q(P[\"NET_INCOME\"])\n    adj_pct = Q(P[\"ADJ\"]) / 100\n\n    # Equity required: equity share of the capital budget\n    equity_required = capex * eq_ratio\n\n    # Adjusted net income: base plus the signed one-time item (fraction of base)\n    one_time_item = base_ni * adj_pct\n    adjusted_ni = base_ni + one_time_item\n\n    # Signed surplus: what is left after funding the equity portion internally\n    signed_surplus = adjusted_ni - equity_required\n\n    # Residual policy: enumerate the two cases explicitly\n    if signed_surplus > 0:\n        dividend = signed_surplus\n        equity_issued = Q(0)\n    elif signed_surplus < 0:\n        dividend = Q(0)\n        equity_issued = -signed_surplus\n    else:\n        dividend = Q(0)\n        equity_issued = Q(0)\n\n    # Consistency check: sources must equal uses of equity funds\n    # adjusted_ni + equity_issued == equity_required + dividend\n    if adjusted_ni + equity_issued != equity_required + dividend:\n        raise ValueError(\"Residual policy ledger does not balance\")\n\n    return {\n        \"final\": dividend,\n        \"equity_required\": equity_required,\n        \"adjusted_net_income\": adjusted_ni,\n        \"signed_surplus\": signed_surplus,\n        \"equity_issued\": equity_issued,\n    }\n",
