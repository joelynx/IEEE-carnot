 "program": "def solve():\n    principal = Q(P[\"PRINCIPAL\"])\n    rate = Q(P[\"RATE\"])\n    months = int(P[\"MONTHS\"])\n    dep_month = int(P[\"DEP_MONTH\"])\n    deposit = Q(P[\"DEPOSIT\"])\n    bump_bp = Q(P[\"BUMP_BP\"])\n    mode = P[\"BUMP_MODE\"]\n    fee = Q(P[\"FEE\"])\n\n    bump_pct = bump_bp / 100  # basis points -> percentage points\n\n    balance = principal\n    total_interest = Q(0)\n    interest_k = None\n\n    for m in range(1, months + 1):\n        if m == dep_month:\n            balance = balance + deposit\n        if mode == \"once\":\n            r = rate + bump_pct if m == dep_month else rate\n        elif mode == \"ongoing\":\n            r = rate + bump_pct if m >= dep_month else rate\n        else:\n            raise ValueError(\"unknown bump mode\")\n        interest = balance * r / 1200\n        total_interest += interest\n        if m == dep_month:\n            interest_k = interest\n        balance = balance + interest - fee\n\n    if interest_k is None:\n        raise ValueError(\"deposit month outside horizon\")\n\n    ear = ((1 + rate / 1200) ** 12 - 1) * 100\n\n    return {\n        \"final\": total_interest,\n        \"interest_month_k\": interest_k,\n        \"ending_balance\": balance,\n        \"effective_annual_rate\": ear,\n    }\n",
