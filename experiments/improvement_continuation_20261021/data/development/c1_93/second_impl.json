 "program": "def solve():\n    A = Q(P[\"A\"]); E = [Q(P[\"E1\"]), Q(P[\"E2\"]), Q(P[\"E3\"])]\n    L = Q(P[\"L\"]) / 100; R = Q(P[\"R\"]); PEN = Q(P[\"PEN\"]); bank = Q(P[\"B0\"])\n    borrowed_prev = Q(0); total_borrowed = Q(0); total_penalty = Q(0)\n    year2_available = None\n    for t in range(3):\n        repayment = R * borrowed_prev\n        available = bank + A - repayment\n        if t == 1:\n            year2_available = available\n        if available >= E[t]:\n            bank = available - E[t]\n            borrowed = Q(0)\n        else:\n            shortfall = E[t] - available\n            bank = Q(0)\n            cap = L * A if t < 2 else Q(0)\n            borrowed = min(shortfall, cap)\n            remaining = shortfall - borrowed\n            total_penalty += remaining * PEN\n        total_borrowed += borrowed\n        borrowed_prev = borrowed\n    return {\n        \"final\": total_penalty,\n        \"year2_available\": year2_available,\n        \"total_borrowed\": total_borrowed,\n        \"closing_bank\": bank,\n    }\n",
