 "program": "def solve():\n    M = P[\"M\"]\n    prices = [P[\"P1\"], P[\"P2\"], P[\"P3\"], P[\"P4\"]]\n    PF = P[\"PF\"]\n    FEE = P[\"FEE\"]\n    WAIVE = P[\"WAIVE\"]\n\n    def net_cash(cash):\n        # commission waived when cash before commission >= WAIVE (equality included)\n        if cash >= WAIVE:\n            return cash\n        return cash - FEE\n\n    # Dollar-cost averaging ledger: month by month\n    dca_shares = 0\n    total_committed = 0\n    for price in prices:\n        cash = M\n        total_committed += cash\n        spend = net_cash(cash)\n        if spend < 0:\n            raise ValueError(\"commission exceeds purchase cash\")\n        dca_shares += spend / price\n\n    if dca_shares == 0:\n        raise ValueError(\"no shares bought\")\n    dca_avg_cost = total_committed / dca_shares\n\n    # Lump sum: single purchase of the four-month total at month-1 price\n    ls_cash = 4 * M\n    ls_spend = net_cash(ls_cash)\n    if ls_spend < 0:\n        raise ValueError(\"commission exceeds purchase cash\")\n    ls_shares = ls_spend / prices[0]\n\n    gain = dca_shares * PF - ls_shares * PF\n\n    return {\n        \"final\": gain,\n        \"dca_shares\": dca_shares,\n        \"dca_avg_cost\": dca_avg_cost,\n        \"ls_shares\": ls_shares,\n    }\n",
