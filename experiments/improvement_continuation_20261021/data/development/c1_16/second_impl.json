 "program": "def solve():\n    gas = Q(P[\"GAS_USED\"])\n    base = Q(P[\"BASE_FEE_GWEI\"])\n    tip = Q(P[\"TIP_GWEI\"])\n    max_fee = Q(P[\"MAX_FEE_GWEI\"])\n    eth_usd = Q(P[\"ETH_USD\"])\n\n    if max_fee < base:\n        raise ValueError(\"max fee below base fee: transaction invalid\")\n\n    headroom = max_fee - base\n    eff_tip = tip if tip <= headroom else headroom\n\n    gwei_per_eth = Q(10) ** 9\n\n    # per gas unit amounts in ETH\n    burn_per_gas_eth = base / gwei_per_eth\n    tip_per_gas_eth = eff_tip / gwei_per_eth\n\n    burned_eth = burn_per_gas_eth * gas\n    tip_eth = tip_per_gas_eth * gas\n    total_fee_eth = burned_eth + tip_eth\n\n    tip_usd = tip_eth * eth_usd\n\n    return {\n        \"final\": tip_usd,\n        \"effective_tip_gwei\": eff_tip,\n        \"burned_eth\": burned_eth,\n        \"total_fee_eth\": total_fee_eth,\n    }\n",
