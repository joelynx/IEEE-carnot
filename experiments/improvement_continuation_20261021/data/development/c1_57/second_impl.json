 "program": "def solve():\n    I0 = Q(P[\"I0\"]); C = Q(P[\"C\"]); N = int(P[\"N\"]); D = Q(P[\"D\"])\n    r = Q(P[\"R\"]) / 100; f = Q(P[\"F\"]) / 100; k = Q(P[\"K\"]) / 100\n\n    # Build net-flow ledger year by year\n    flows = {0: -I0}\n    for t in range(1, N + 1):\n        flows[t] = C\n    flows[N] = C - D  # year-N net flow = inflow minus decommissioning cost\n\n    # NPV on net flows at rate R\n    npv = Q(0)\n    for t, cf in flows.items():\n        npv += cf / (1 + r) ** t\n    npv_positive = \"positive\" if npv > 0 else \"not_positive\"\n\n    # Classify flows by sign for MIRR\n    pv_neg = Q(0)\n    fv_pos = Q(0)\n    for t, cf in flows.items():\n        if cf < 0:\n            pv_neg += (-cf) / (1 + f) ** t\n        elif cf > 0:\n            fv_pos += cf * (1 + k) ** (N - t)\n        # zero flows ignored\n\n    if pv_neg <= 0 or fv_pos <= 0:\n        raise ValueError(\"MIRR undefined: need both negative and positive flows\")\n\n    # MIRR: pv_neg * (1+m)^N = fv_pos\n    ratio = fv_pos / pv_neg\n    m = exp(ln(ratio) / N) - 1\n    mirr_pct = m * 100\n\n    return {\n        \"final\": mirr_pct,\n        \"npv\": npv,\n        \"npv_positive\": npv_positive,\n        \"pv_negative_flows\": pv_neg,\n        \"fv_positive_flows\": fv_pos,\n    }\n",
