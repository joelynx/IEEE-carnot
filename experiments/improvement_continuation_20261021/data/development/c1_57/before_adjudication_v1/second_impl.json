 "program": "def solve():\n    I0 = P[\"I0\"]; C = P[\"C\"]; N = P[\"N\"]; D = P[\"D\"]\n    R = Q(P[\"R\"]) / 100\n    F = Q(P[\"F\"]) / 100\n    K = Q(P[\"K\"]) / 100\n\n    # Build the net flow ledger year by year\n    flows = {0: -Q(I0)}\n    for t in range(1, N + 1):\n        flows[t] = Q(C)\n    flows[N] = Q(C) - Q(D)\n\n    # NPV at R\n    npv = Q(0)\n    for t, cf in flows.items():\n        npv += cf / (1 + R) ** t\n\n    # Classify flows by sign\n    pv_neg = Q(0)   # magnitude of PV of negative flows at finance rate\n    fv_pos = Q(0)   # FV at year N of positive flows at reinvestment rate\n    for t, cf in flows.items():\n        if cf < 0:\n            pv_neg += (-cf) / (1 + F) ** t\n        elif cf > 0:\n            fv_pos += cf * (1 + K) ** (N - t)\n        # zero flows ignored\n\n    if pv_neg <= 0 or fv_pos <= 0:\n        raise ValueError(\"MIRR undefined: need both negative and positive flows\")\n\n    # MIRR: (1+m)^N = fv_pos / pv_neg  -> find growth factor g=(1+m) by bisection\n    ratio = fv_pos / pv_neg\n    lo = Q(0)\n    hi = Q(1)\n    while hi ** N < ratio:\n        hi *= 2\n    for _ in range(200):\n        mid = (lo + hi) / 2\n        if mid ** N < ratio:\n            lo = mid\n        else:\n            hi = mid\n    g = (lo + hi) / 2\n    m = g - 1\n    mirr_pct = m * 100\n\n    return {\n        \"final\": mirr_pct,\n        \"npv\": npv,\n        \"npv_positive\": \"positive\" if npv > 0 else \"not_positive\",\n        \"pv_negative_flows\": pv_neg,\n        \"fv_positive_flows\": fv_pos,\n    }\n",
