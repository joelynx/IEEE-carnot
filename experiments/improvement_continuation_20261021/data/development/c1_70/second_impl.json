 "program": "def solve():\n    base = Q(P[\"BASE\"])\n    bps = [Q(P[\"BPS_A\"]), Q(P[\"BPS_B\"]), Q(P[\"BPS_C\"])]\n    comp = [P[\"Q_A\"], P[\"Q_B\"], P[\"Q_C\"]]\n    cost_pct = Q(P[\"COST_PCT\"])\n\n    annual = [base * b / 10000 for b in bps]\n    quarterly = [a / 4 for a in annual]\n    costs = [a * cost_pct / 100 for a in annual]\n\n    # Period-by-period ledger\n    cum = Q(0)\n    cum_by_q = {}\n    earned_by_q = {}\n    for q in range(1, 9):\n        earned = Q(0)\n        incurred = Q(0)\n        for i in range(3):\n            if q == comp[i]:\n                incurred += costs[i]\n            if q > comp[i]:\n                earned += quarterly[i]\n        cum += earned - incurred\n        cum_by_q[q] = cum\n        earned_by_q[q] = earned\n\n    first_pos = 0\n    for q in range(1, 9):\n        if cum_by_q[q] > 0:\n            first_pos = q\n            break\n\n    return {\n        \"final\": cum_by_q[8],\n        \"total_one_time_cost\": sum(costs, Q(0)),\n        \"run_rate_quarterly_saving\": earned_by_q[8],\n        \"first_positive_quarter\": Q(first_pos),\n        \"cumulative_after_q4\": cum_by_q[4],\n    }\n",
