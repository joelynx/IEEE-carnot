 "program": "def solve():\n    m = Q(P[\"NET_MARGIN\"]) / 100\n    em = Q(P[\"EQUITY_MULTIPLIER\"])\n    t = Q(P[\"TARGET_ROE\"]) / 100\n    F = Q(P[\"FIXED_ASSETS\"])\n    v = Q(P[\"VARIABLE_SHARE\"])\n\n    # ROE(S) = m * (S / (F + v*S)) * em, increasing in S, bounded above by m*em/v\n    # Feasible only if the target lies strictly below that asymptote.\n    asymptote = m * em / v\n    if t >= asymptote:\n        raise ValueError(\"Target ROE cannot be reached at any positive sales level\")\n\n    # Solve m*em*S = t*(F + v*S)\n    S = t * F / (m * em - t * v)\n    if S <= 0:\n        raise ValueError(\"No positive sales level reaches the target\")\n\n    total_assets = F + v * S\n    turnover = S / total_assets\n    equity = total_assets / em\n\n    # consistency check via DuPont\n    net_income = m * S\n    roe = net_income / equity\n    if roe != t:\n        raise ValueError(\"Inconsistent solution\")\n\n    return {\n        \"final\": S,\n        \"total_assets\": total_assets,\n        \"asset_turnover\": turnover,\n        \"shareholders_equity\": equity,\n    }\n",
