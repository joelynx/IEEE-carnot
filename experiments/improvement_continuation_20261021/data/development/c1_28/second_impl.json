 "program": "def solve():\n    gross_t1 = Fraction(P[\"GROSS_T1\"])\n    goodwill = Fraction(P[\"GOODWILL\"])\n    dta = Fraction(P[\"DTA\"])\n    dta_thresh_pct = Fraction(P[\"DTA_THRESH_PCT\"])\n    on_bs = Fraction(P[\"ON_BS\"])\n    undrawn = Fraction(P[\"UNDRAWN\"])\n    ccf_pct = Fraction(P[\"CCF_PCT\"])\n    min_pct = Fraction(P[\"MIN_PCT\"])\n\n    # Deductions ledger\n    deductions = []\n    deductions.append(goodwill)\n    threshold = gross_t1 * dta_thresh_pct / 100\n    excess_dta = dta - threshold\n    if excess_dta > 0:\n        deductions.append(excess_dta)\n    else:\n        deductions.append(Fraction(0))\n\n    tier1_after = gross_t1\n    for d in deductions:\n        tier1_after -= d\n\n    if tier1_after <= 0:\n        raise ValueError(\"Tier 1 capital after deductions is zero or negative\")\n\n    # Exposure measure ledger\n    exposure_items = [on_bs, undrawn * ccf_pct / 100]\n    exposure = Fraction(0)\n    for e in exposure_items:\n        exposure += e\n\n    leverage_ratio_pct = tier1_after / exposure * 100\n\n    # Shortfall: additional capital so that (T1 + x)/E * 100 = min_pct\n    required_t1 = min_pct / 100 * exposure\n    shortfall = required_t1 - tier1_after\n    if shortfall < 0:\n        shortfall = Fraction(0)\n\n    return {\n        \"final\": shortfall,\n        \"tier1_after_deductions\": tier1_after,\n        \"exposure_measure\": exposure,\n        \"leverage_ratio_percent\": leverage_ratio_pct,\n    }\n",
