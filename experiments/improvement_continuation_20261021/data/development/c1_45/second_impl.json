 "program": "def solve():\n    open_inv = Q(P[\"OPEN_INV\"])\n    h2 = Q(P[\"H2_CHANGE\"])\n    cogs_sa = Q(P[\"COGS_SA\"])\n    acq_month = int(P[\"ACQ_MONTH\"])\n    acq_inv = Q(P[\"ACQ_INV\"])\n    acq_cogs_m = Q(P[\"ACQ_COGS_MONTH\"])\n    days = Q(P[\"DAYS\"])\n\n    include = acq_month <= 6\n\n    # Month-by-month ledger of consolidated balances and COGS\n    weighted_sum = Q(0)\n    cogs_used = cogs_sa\n    for m in range(1, 13):\n        bal = open_inv if m <= 6 else open_inv + h2\n        if include and m >= acq_month:\n            bal += acq_inv\n            cogs_used += acq_cogs_m\n        weighted_sum += bal\n\n    avg_inv = weighted_sum / 12\n    if avg_inv == 0:\n        raise ValueError(\"Average inventory is zero\")\n    turnover = cogs_used / avg_inv\n    if turnover == 0:\n        raise ValueError(\"Turnover is zero\")\n    dio = days / turnover\n\n    return {\n        \"final\": dio,\n        \"avg_inventory\": avg_inv,\n        \"cogs_used\": cogs_used,\n        \"turnover\": turnover,\n    }\n",
