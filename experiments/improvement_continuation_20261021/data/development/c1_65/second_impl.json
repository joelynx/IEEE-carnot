 "program": "def solve():\n    headline = Fraction(P[\"HEADLINE_PRICE\"])\n    revenue = Fraction(P[\"REVENUE\"])\n    peg_pct = Fraction(P[\"PEG_PCT\"])\n    actual_k = Fraction(P[\"ACTUAL_NWC_K\"])\n    band_bp = Fraction(P[\"BAND_BP\"])\n\n    # Peg in USD million: percent of trailing revenue\n    peg = revenue * peg_pct / 100\n\n    # Collar half-width in USD million: basis points of headline price\n    band = headline * band_bp / 10000\n\n    # Closing NWC converted from USD thousand to USD million\n    actual = actual_k / 1000\n\n    lower = peg - band\n    upper = peg + band\n\n    # Enumerate the three cases explicitly\n    if actual > upper:\n        excess = actual - upper\n    elif actual < lower:\n        excess = actual - lower  # negative\n    else:\n        excess = Fraction(0)\n\n    adjusted = headline + excess\n\n    return {\n        \"final\": adjusted,\n        \"peg_usd_million\": peg,\n        \"band_usd_million\": band,\n        \"excess_outside_band\": excess,\n    }\n",
