 "program": "def solve():\n    units = P[\"UNITS\"]\n    open_rate = P[\"OPEN\"]\n    close_rate = P[\"CLOSE\"]\n    days = P[\"DAYS\"]\n    r_base = P[\"R_BASE\"] / 100\n    r_quote = P[\"R_QUOTE\"] / 100\n    markup = P[\"MARKUP\"] / 100\n    cap = P[\"CAP\"]\n\n    notional = units * open_rate\n\n    # Day-by-day ledger for carry\n    gross_daily = notional * (r_quote - r_base) / 360\n    markup_daily = notional * markup / 360\n    net_daily = gross_daily - markup_daily\n    if net_daily > 0 and net_daily > cap:\n        net_daily = Fraction(cap)\n\n    total_carry = Fraction(0)\n    for _ in range(days):\n        total_carry += net_daily\n\n    # Price P&L for a short\n    price_pnl = (open_rate - close_rate) * units\n\n    pre_fee = total_carry + price_pnl - 10\n    if pre_fee > 0:\n        final = pre_fee - pre_fee * Fraction(20, 100)\n    else:\n        final = pre_fee\n\n    return {\n        \"final\": final,\n        \"daily_net_carry\": net_daily,\n        \"total_carry\": total_carry,\n        \"price_pnl\": price_pnl,\n    }\n",
