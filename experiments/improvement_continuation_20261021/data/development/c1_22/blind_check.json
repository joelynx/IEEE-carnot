        "code": "def solve():\n    genesis = Q(50000000)\n    R = genesis * Q(120) / Q(10000)\n    burn_rate = Q(17, 100)\n    query = 28\n    # halvings: originally at 7,13,19,...; those before 13 stand (7); then every 20 after 7: 27, 47, ...\n    halvings = [7]\n    h = 7\n    while True:\n        h += 20\n        halvings.append(h)\n        if h > query + 40:\n            break\n    def reward(e):\n        n = sum(1 for x in halvings if x <= e)\n        return R / (2 ** n)\n    gross = sum(reward(e) for e in range(1, query + 1))\n    burned = gross * burn_rate\n    net = gross - burned\n    next_h = min(x for x in halvings if x > query)\n    return {\n        \"final\": net / genesis * 100,\n        \"gross_reward_at_query_epoch\": reward(query),\n        \"next_halving_epoch\": next_h,\n        \"cumulative_gross_tokens\": gross,\n        \"cumulative_burned_tokens\": burned,\n    }\n",
