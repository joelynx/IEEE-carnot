 "program": "def solve():\n    nominal_bp = P[\"NOMINAL_BP\"]\n    min_pct = P[\"MIN_PCT\"]\n    deposit = P[\"DEPOSIT\"]\n    months = P[\"MONTHS\"]\n\n    # Nominal annual rate as a decimal fraction\n    r = Q(nominal_bp, 10000)\n    monthly_rate = r / 12\n\n    # One-year growth factor built period by period (12 monthly credits)\n    growth = Q(1)\n    for _ in range(12):\n        growth = growth * (1 + monthly_rate)\n\n    # Equivalent continuously compounded annual rate: exp(c) = growth\n    c_converted = ln(growth)\n\n    # Minimum continuous rate check\n    c_min = min_pct / 100\n    if c_converted < c_min:\n        c_credited = c_min\n    else:\n        c_credited = c_converted\n\n    # Effective annual rate under the credited continuous rate\n    ear = exp(c_credited) - 1\n\n    # Gap in basis points\n    gap_bp = (ear - c_credited) * 10000\n\n    # Ending value of deposit after MONTHS/12 years of continuous growth\n    t_years = Q(months, 12)\n    ending_value = deposit * exp(c_credited * t_years)\n\n    return {\n        \"final\": ending_value,\n        \"credited_continuous_rate_pct\": c_credited * 100,\n        \"effective_annual_rate_pct\": ear * 100,\n        \"gap_bp\": gap_bp,\n    }\n",
