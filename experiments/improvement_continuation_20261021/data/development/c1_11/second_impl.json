 "program": "def solve():\n    VU = Q(P[\"VU\"])\n    B = Q(P[\"B\"])\n    A = Q(P[\"A\"])\n    K = int(P[\"K\"])\n    rd = Q(P[\"RD\"]) / 100\n    t = Q(P[\"T\"]) / 100\n\n    # period-by-period ledger of the debt balance\n    bal = B\n    amort_pv = Q(0)\n    disc = Q(1)\n    for yr in range(1, K + 1):\n        disc = disc * (1 + rd)\n        interest = bal * rd\n        shield = interest * t\n        amort_pv += shield / disc\n        bal = bal - A\n        if bal <= 0:\n            raise ValueError(\"repayment schedule leaves a non-positive balance\")\n\n    remaining = bal\n    perm_value_at_K = t * remaining\n    perm_pv = perm_value_at_K / disc\n\n    total_shield = amort_pv + perm_pv\n    VL = VU + total_shield\n    E = VL - B\n\n    return {\n        \"final\": E,\n        \"remaining_permanent_balance\": remaining,\n        \"amortizing_shield_pv\": amort_pv,\n        \"tax_shield_value\": total_shield,\n        \"levered_firm_value\": VL,\n    }\n",
