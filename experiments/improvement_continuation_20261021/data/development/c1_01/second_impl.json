 "program": "def solve():\n    premium = Q(P[\"PREMIUM\"])\n    policy_months = int(P[\"POLICY_MONTHS\"])\n    start_month = int(P[\"START_MONTH\"])\n    principal = Q(P[\"PRINCIPAL\"])\n    rate = Q(P[\"RATE\"])\n    loan_month = int(P[\"LOAN_MONTH\"])\n    pay_interval = int(P[\"PAY_INTERVAL\"])\n\n    # --- Insurance: month-by-month ledger ---\n    monthly_ins = premium / policy_months\n    prepaid = Q(0)\n    ins_expense = Q(0)\n    for m in range(1, 13):\n        if m == start_month:\n            prepaid += premium  # cash paid, asset recorded\n        # coverage month index (1-based) within policy\n        if m >= start_month and (m - start_month) < policy_months:\n            ins_expense += monthly_ins\n            prepaid -= monthly_ins\n\n    # --- Loan interest: month-by-month ledger ---\n    monthly_int = principal * rate / 100 / 12\n    accrued = Q(0)\n    int_expense = Q(0)\n    months_since_draw = 0\n    for m in range(1, 13):\n        if m >= loan_month:\n            # interest accrues this month\n            int_expense += monthly_int\n            accrued += monthly_int\n            months_since_draw += 1\n            # payment at end of each PAY_INTERVAL-month period from drawdown\n            if months_since_draw % pay_interval == 0:\n                accrued = Q(0)  # paid in cash in arrears\n\n    total = ins_expense + int_expense\n\n    return {\n        \"final\": total,\n        \"prepaid_insurance_asset\": prepaid,\n        \"accrued_interest_liability\": accrued,\n        \"insurance_expense\": ins_expense,\n    }\n",
