 "program": "def solve():\n    bal0 = Q(P[\"BAL\"])\n    pmt = Q(P[\"PMT\"])\n    rate_bp = Q(P[\"RATE_BP\"])\n    def_pct = Q(P[\"DEF_PCT\"])\n    fee = Q(P[\"FEE\"])\n    n = int(P[\"N\"])\n\n    # Regular monthly rate as a fraction and in percent\n    annual_rate = rate_bp / 10000\n    monthly_rate = annual_rate / 12\n    monthly_rate_pct = monthly_rate * 100\n\n    # Deferral interest: simple, uncompounded, on the month-1 opening balance, for 2 months\n    deferral_interest = bal0 * (def_pct / 100) * 2\n    capitalized_amount = deferral_interest + fee\n\n    # Balance at end of month 2 after single capitalization\n    balance = bal0 + capitalized_amount\n\n    # Resumed payments from month 3: closed-form after k payments\n    # B_k = B_0*(1+r)^k - PMT * ((1+r)^k - 1)/r\n    def balance_after(k):\n        g = (1 + monthly_rate) ** k\n        if monthly_rate == 0:\n            return balance - pmt * k\n        return balance * g - pmt * (g - 1) / monthly_rate\n\n    balance_after_first = balance_after(1)\n    balance_after_n = balance_after(n)\n\n    return {\n        \"final\": balance_after_n,\n        \"monthly_rate_pct\": monthly_rate_pct,\n        \"capitalized_amount\": capitalized_amount,\n        \"balance_after_first_resumed\": balance_after_first,\n    }\n",
