 "program": "def solve():\n    N = P[\"N\"]\n    B0 = P[\"B0\"]\n    P1 = P[\"P1\"]\n    D = P[\"D\"]\n    R = P[\"R\"]\n    P2 = P[\"P2\"]\n    P3 = P[\"P3\"]\n    C = P[\"C\"]\n\n    # First sale: signed result per share and total\n    per_share_first = P1 - B0\n    first_total = per_share_first * N\n\n    # Wash-sale check: loss on first sale and repurchase within 30 days inclusive\n    disallowed = 0\n    if per_share_first < 0 and D <= 30:\n        covered = N if N < R else R\n        disallowed = (-per_share_first) * covered\n\n    allowed_first = first_total + disallowed  # loss reduced toward zero by disallowed part\n\n    # New lot basis with disallowed loss added\n    lot_basis = P2 * R + disallowed\n\n    # Second sale of whole new lot\n    second_result = P3 * R - lot_basis\n\n    net = allowed_first + second_result\n\n    if net < 0:\n        loss = -net\n        if loss > C:\n            deduction = C\n            carry = loss - C\n        else:\n            deduction = loss\n            carry = 0\n    else:\n        deduction = 0\n        carry = 0\n\n    return {\n        \"final\": carry,\n        \"disallowed_loss\": disallowed,\n        \"adjusted_lot_basis\": lot_basis,\n        \"net_result\": net,\n        \"year_deduction\": deduction,\n    }\n",
