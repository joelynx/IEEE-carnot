 "program": "def solve():\n    rs = [Fraction(P[\"R1\"]), Fraction(P[\"R2\"]), Fraction(P[\"R3\"]), Fraction(P[\"R4\"])]\n    floor = Fraction(P[\"FLOOR_PCT\"])\n    fee = Fraction(P[\"FEE_BP\"]) / 100  # percentage points\n    order = P[\"FEE_ORDER\"]\n\n    fund = Fraction(1)\n    index = Fraction(1)\n    events = 0\n    for r in rs:\n        gross = 2 * r\n        if order == \"fee_after_floor\":\n            x = gross\n            if x < floor:\n                x = floor\n                events += 1\n            net = x - fee\n        elif order == \"fee_before_floor\":\n            x = gross - fee\n            if x < floor:\n                x = floor\n                events += 1\n            net = x\n        else:\n            raise ValueError(\"unknown fee order\")\n        fund = fund * (1 + net / 100)\n        index = index * (1 + r / 100)\n\n    fund_cum = (fund - 1) * 100\n    twice_idx = 2 * (index - 1) * 100\n    diff = fund_cum - twice_idx\n    return {\n        \"final\": diff,\n        \"fund_cum_return_pct\": fund_cum,\n        \"twice_index_cum_pct\": twice_idx,\n        \"floor_event_days\": Fraction(events),\n    }\n",
