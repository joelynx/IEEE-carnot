 "program": "def solve():\n    inv = Q(P[\"INV\"])          # USD million\n    b0 = Q(P[\"B\"])             # thousand beneficiaries in year 1\n    drop = Q(P[\"DROP\"]) / 100\n    v = Q(P[\"V\"])              # USD per beneficiary per year\n    dw = Q(P[\"DW\"]) / 100\n    attr = Q(P[\"ATTR\"]) / 100\n    mode = P[\"ATTR_MODE\"]\n    basis = P[\"BASIS\"]\n\n    if mode == \"the_programme\":\n        share = attr\n    elif mode == \"other_actors\":\n        share = 1 - attr\n    else:\n        raise ValueError(\"unknown attribution mode\")\n\n    # Year-by-year ledger of active beneficiaries and gross value (USD million)\n    gross_years = []\n    active = b0\n    for yr in range(1, 5):\n        if yr > 1:\n            active = active * (1 - drop)\n        # thousand beneficiaries * USD -> USD thousands -> USD million (/1000)\n        gross = active * v / 1000\n        gross_years.append(gross)\n\n    net_years = [g * (1 - dw) * share for g in gross_years]\n\n    gross_cum = sum(gross_years)\n    net_first = net_years[0]\n    net_cum = sum(net_years)\n\n    if basis == \"cumulative\":\n        numer = net_cum\n    elif basis == \"first_year\":\n        numer = net_first\n    else:\n        raise ValueError(\"unknown basis\")\n\n    if inv == 0:\n        raise ValueError(\"investment must be positive\")\n\n    sroi = numer / inv\n\n    return {\n        \"final\": sroi,\n        \"gross_cumulative_value\": gross_cum,\n        \"programme_attribution_share\": share,\n        \"net_first_year_value\": net_first,\n        \"net_cumulative_value\": net_cum,\n    }\n",
