 "program": "def solve():\n    T = P[\"T\"]\n    A1 = P[\"A1\"]\n    A2 = P[\"A2\"]\n    B1 = P[\"B1\"]\n    C1 = P[\"C1\"]\n\n    # Ledger: (customer, day) -> list of deposits\n    ledger = {\n        (\"X\", 1): [A1, A2],\n        (\"X\", 2): [B1],\n        (\"Y\", 2): [C1],\n    }\n\n    reports = []  # (customer, day, amount)\n    for (cust, day), deps in ledger.items():\n        agg = sum(deps)\n        if agg > T:\n            reports.append((cust, day, agg))\n        else:\n            for d in deps:\n                if d > T:\n                    reports.append((cust, day, d))\n\n    day1_aggregate = A1 + A2\n    day1_report_count = sum(1 for r in reports if r[1] == 1)\n    total_report_count = len(reports)\n    total_amount = sum(r[2] for r in reports)\n\n    return {\n        \"final\": total_amount,\n        \"day1_aggregate\": day1_aggregate,\n        \"day1_report_count\": day1_report_count,\n        \"total_report_count\": total_report_count,\n    }\n",
