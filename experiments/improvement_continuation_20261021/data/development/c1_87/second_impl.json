 "program": "def solve():\n    E0 = Q(P[\"E0\"])\n    prof = Q(P[\"P\"])\n    G = Q(P[\"G\"])\n    DIV = Q(P[\"DIV\"])\n    R0 = Q(P[\"R0\"])\n    D = Q(P[\"D\"])\n    H = Q(P[\"H\"])\n\n    # Quarter-by-quarter equity ledger\n    equity = E0\n    quarter_profit = prof\n    for q in range(4):\n        equity += quarter_profit\n        quarter_profit += G\n    closing_equity = equity - DIV\n\n    # Stress: USD per EUR falls by D percent -> EUR per USD rises\n    usd_per_eur_pre = 1 / R0\n    usd_per_eur_stressed = usd_per_eur_pre * (1 - D / 100)\n    if usd_per_eur_stressed <= 0:\n        raise ValueError(\"Stressed rate must be positive\")\n    R1 = 1 / usd_per_eur_stressed\n\n    equity_before = closing_equity * usd_per_eur_pre\n    equity_after = closing_equity * usd_per_eur_stressed\n    gross_loss = equity_before - equity_after\n\n    notional = E0 * H / 100\n    hedge_gain = notional * usd_per_eur_pre - notional * usd_per_eur_stressed\n\n    net_loss = gross_loss - hedge_gain\n\n    return {\n        \"final\": net_loss,\n        \"stressed_rate_eur_per_usd\": R1,\n        \"equity_before_usd_million\": equity_before,\n        \"equity_after_usd_million\": equity_after,\n        \"gross_loss_usd_million\": gross_loss,\n    }\n",
