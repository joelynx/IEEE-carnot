 "program": "def solve():\n    D0 = P[\"D0\"]\n    g1_bp = P[\"G1_BP\"]\n    n_q = P[\"N_Q\"]\n    g2_pct = P[\"G2_PCT\"]\n    r_eff = P[\"R_EFF\"]\n    conv = P[\"CONV\"]\n\n    # Quarterly discount rate: (1+R)^(1/4) - 1, computed via two square roots\n    one_plus_r = 1 + r_eff / 100\n    q = sqrt(sqrt(one_plus_r)) - 1\n\n    # Stage-one quarterly growth rate from basis points\n    g1 = Q(g1_bp, 10000)\n\n    # Stage-two quarterly growth rate\n    if conv == \"compound\":\n        g2q = sqrt(sqrt(1 + g2_pct / 100)) - 1\n    elif conv == \"nominal\":\n        g2q = g2_pct / 400\n    else:\n        raise ValueError(\"unknown convention\")\n\n    # Period-by-period ledger of stage-one dividends\n    div = D0\n    disc = 1\n    pv_stage_one = 0\n    for t in range(1, n_q + 1):\n        div = div * (1 + g1)\n        disc = disc * (1 + q)\n        pv_stage_one += div / disc\n\n    # Terminal value at end of last stage-one quarter\n    if not (g2q < q):\n        raise ValueError(\"stage-two growth must be below the quarterly discount rate\")\n    first_stage_two_div = div * (1 + g2q)\n    tv = first_stage_two_div / (q - g2q)\n\n    price = pv_stage_one + tv / disc\n\n    return {\n        \"final\": price,\n        \"quarterly_rate\": q * 100,\n        \"stage_one_pv\": pv_stage_one,\n        \"terminal_value\": tv,\n    }\n",
