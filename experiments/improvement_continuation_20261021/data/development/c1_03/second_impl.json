 "program": "def solve():\n    NI = P[\"NI\"]\n    DEP = P[\"DEP\"]\n    DIV = P[\"DIV\"]\n    COST = P[\"COST\"]\n    PROCEEDS = P[\"PROCEEDS\"]\n    LOAN = P[\"LOAN\"]\n    CLOSE_MONTHS = P[\"CLOSE_MONTHS\"]\n    WC_CHG = P[\"WC_CHG\"]\n\n    # Equipment sale: book value after 60% depreciation\n    accumulated_dep = COST * Q(60, 100)\n    book_value = COST - accumulated_dep\n    gain = PROCEEDS - book_value  # negative if loss\n\n    # Interest on the loan, 8% for the full year\n    interest_expense = LOAN * Q(8, 100)\n    monthly_interest = interest_expense / 12\n    payable_open = monthly_interest * 2\n    payable_close = monthly_interest * CLOSE_MONTHS\n    payable_increase = payable_close - payable_open\n    interest_paid = interest_expense - payable_increase\n\n    # Operating cash flow ledger under the stated policy\n    ledger = []\n    ledger.append(NI)                 # start from net income\n    ledger.append(DEP)                # non-cash depreciation added back\n    ledger.append(-gain)              # remove gain (adds back a loss)\n    ledger.append(interest_expense)   # interest classified as financing: add back full expense\n    ledger.append(-DIV)               # dividend income classified as investing: remove\n    ledger.append(-WC_CHG)            # increase in NOWC reduces operating cash\n    operating_cf = sum(ledger, Q(0))\n\n    # Investing: full sale proceeds plus dividends received in cash\n    investing_cf = PROCEEDS + DIV\n\n    return {\n        \"final\": operating_cf,\n        \"gain_on_sale\": gain,\n        \"interest_expense\": interest_expense,\n        \"interest_paid_financing\": interest_paid,\n        \"investing_cash_flow\": investing_cf,\n    }\n",
