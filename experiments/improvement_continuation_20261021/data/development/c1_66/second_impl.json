 "program": "def solve():\n    tgt_px = Q(P[\"TGT_PX\"])\n    prem = Q(P[\"PREM\"])\n    acq_px = Q(P[\"ACQ_PX\"])\n    tgt_sh = Q(P[\"TGT_SH\"]) * 1000000\n    acq_sh = Q(P[\"ACQ_SH\"]) * 1000000\n    move = Q(P[\"MOVE\"])\n    fee = Q(P[\"FEE\"])\n\n    # Offer price per Target share\n    offer_px = tgt_px * (1 + prem / 100)\n\n    # Fixed exchange ratio\n    exchange_ratio = offer_px / acq_px\n\n    # Shares issued to Target holders\n    target_holder_shares = exchange_ratio * tgt_sh\n\n    # Acquirer closing price\n    close_px = acq_px * (1 + move / 100)\n\n    # Value received per Target share at closing\n    value_received = exchange_ratio * close_px\n    realized_gain_pct = (value_received - tgt_px) / tgt_px * 100\n\n    # Advisory fees: percent of total offer value, paid in shares at closing price\n    total_offer_value = offer_px * tgt_sh\n    fee_amount = total_offer_value * fee / 100\n    fee_shares = fee_amount / close_px\n\n    # Combined share count and Target holders' ownership\n    combined = acq_sh + target_holder_shares + fee_shares\n    ownership_pct = target_holder_shares / combined * 100\n\n    return {\n        \"final\": ownership_pct,\n        \"exchange_ratio\": exchange_ratio,\n        \"target_holder_shares\": target_holder_shares,\n        \"realized_gain_pct\": realized_gain_pct,\n        \"fee_shares\": fee_shares,\n    }\n",
