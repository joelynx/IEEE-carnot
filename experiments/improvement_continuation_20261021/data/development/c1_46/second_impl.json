 "program": "def solve():\n    ni1 = Q(P[\"NI_1\"])\n    g = Q(P[\"GROWTH\"]) / 100\n    charge = Q(P[\"CHARGE\"])\n    share = Q(P[\"SHARE\"]) / 100\n    prior = Q(P[\"PRIOR\"])\n    cash = Q(P[\"CASH\"])\n    ebitda = Q(P[\"EBITDA\"])\n    request = Q(P[\"REQUEST\"])\n    gross_debt = Q(310)\n    general = Q(12)\n    threshold = Q(3)\n\n    # Year-by-year ledger of net income\n    cumulative = Q(0)\n    pre_charge = ni1\n    for year in range(1, 5):\n        if year > 1:\n            pre_charge = pre_charge * (1 + g)\n        ni = pre_charge\n        if year == 2:\n            ni = ni - charge  # may be a loss year; still added to cumulative\n        cumulative += ni\n\n    builder = share * cumulative - prior\n    if builder < 0:\n        builder = Q(0)\n\n    proposed = min(request, builder + general)\n    cash_after = cash - proposed\n    pro_forma = (gross_debt - cash_after) / ebitda\n\n    blocked = pro_forma > threshold\n    if blocked:\n        permitted = min(request, general)\n    else:\n        permitted = proposed\n\n    return {\n        \"final\": permitted,\n        \"cumulative_net_income\": cumulative,\n        \"builder_capacity\": builder,\n        \"pro_forma_leverage\": pro_forma,\n        \"block_applies\": \"yes\" if blocked else \"no\",\n    }\n",
