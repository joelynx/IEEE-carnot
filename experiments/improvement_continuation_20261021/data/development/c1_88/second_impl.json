 "program": "def solve():\n    W_A = Q(P[\"W_A\"]); W_B = Q(P[\"W_B\"]); W_C = Q(P[\"W_C\"])\n    W_D = Q(100) - W_A - W_B - W_C\n    if W_D < 1:\n        raise ValueError(\"benchmark invalid: weight of D below 1%\")\n    names = [\"A\", \"B\", \"C\", \"D\"]\n    weights = {\"A\": W_A, \"B\": W_B, \"C\": W_C, \"D\": W_D}\n    scores = {\"A\": Q(P[\"S_A\"]), \"B\": Q(P[\"S_B\"]), \"C\": Q(P[\"S_C\"]), \"D\": Q(P[\"S_D\"])}\n    target = P[\"TARGET\"]\n    if target not in names:\n        raise ValueError(\"unknown target\")\n\n    # benchmark-weighted average score (weights in %, divide by 100)\n    avg = sum(weights[n] * scores[n] for n in names) / Q(100)\n\n    # tilt factors with floor applied before renormalization\n    tilted_raw = {}\n    for n in names:\n        f = 1 + 2 * (scores[n] - avg) / Q(100)\n        if f < Q(\"0.25\"):\n            f = Q(\"0.25\")\n        tilted_raw[n] = weights[n] * f\n\n    total = sum(tilted_raw[n] for n in names)\n    if total <= 0:\n        raise ValueError(\"tilted weights sum to zero\")\n    tilted = {n: tilted_raw[n] * Q(100) / total for n in names}\n\n    tilted_score = sum(tilted[n] * scores[n] for n in names) / Q(100)\n    active = tilted[target] - weights[target]\n\n    return {\n        \"final\": tilted[target],\n        \"benchmark_avg_score\": avg,\n        \"tilted_portfolio_score\": tilted_score,\n        \"active_weight_pp\": active,\n    }\n",
