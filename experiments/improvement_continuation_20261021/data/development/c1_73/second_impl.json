 "program": "def solve():\n    alloc = Q(P[\"ALLOC\"])\n    cap = Q(P[\"CAP\"])\n    savings = Q(P[\"SAVE0\"])\n    spends = [Q(P[\"S1\"]), Q(P[\"S2\"]), Q(P[\"S3\"])]\n\n    carry = Q(0)\n    transfers = Q(0)\n    carry_history = []\n\n    for s in spends:\n        available = alloc + carry\n        unspent = available - s\n        if unspent < 0:\n            # shortfall drawn from savings; carryover resets\n            savings += unspent\n            carry = Q(0)\n        else:\n            if unspent > cap:\n                excess = unspent - cap\n                transfers += excess\n                savings += excess\n                carry = cap\n            else:\n                carry = unspent\n        carry_history.append(carry)\n\n    return {\n        \"final\": savings,\n        \"carry_into_month2\": carry_history[0],\n        \"total_transfers_to_savings\": transfers,\n        \"final_carryover\": carry_history[2],\n    }\n",
