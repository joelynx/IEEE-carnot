 "program": "def solve():\n    V = P[\"V\"]\n    w1 = Q(P[\"W1\"]) / 100\n    w2 = 1 - w1\n    s1 = Q(P[\"S1\"]) / 100\n    s2 = Q(P[\"S2\"]) / 100\n    rho = Q(P[\"RHO\"])\n    z = Q(P[\"Z\"])\n    L = Q(P[\"L\"]) / 100\n\n    # Two-asset variance, built from the covariance matrix entry by entry\n    cov11 = s1 * s1\n    cov22 = s2 * s2\n    cov12 = rho * s1 * s2\n    weights = [w1, w2]\n    cov = [[cov11, cov12], [cov12, cov22]]\n    var = 0\n    for i in range(2):\n        for j in range(2):\n            var += weights[i] * weights[j] * cov[i][j]\n    if var <= 0:\n        raise ValueError(\"portfolio variance must be positive\")\n    sigma_p = sqrt(var)\n\n    total_var = V * z * sigma_p\n\n    # Marginal contribution: d sigma / d w_i = (Cov w)_i / sigma\n    cov_w = [sum(cov[i][j] * weights[j] for j in range(2)) for i in range(2)]\n    marg = [cw / sigma_p for cw in cov_w]\n    comp = [V * z * weights[i] * marg[i] for i in range(2)]\n\n    # Limit rule applied once\n    limit = L * V\n    if total_var > limit:\n        factor = limit / total_var\n    else:\n        factor = 1\n\n    comp_after = [c * factor for c in comp]\n\n    return {\n        \"final\": comp_after[0],\n        \"portfolio_volatility\": sigma_p * 100,\n        \"unscaled_total_var\": total_var,\n        \"position_cut_factor\": factor,\n        \"component_var_asset2_after_rule\": comp_after[1],\n    }\n",
