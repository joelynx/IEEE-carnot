 "program": "def solve():\n    CAC = Q(P[\"CAC\"])\n    SPEND = Q(P[\"SPEND\"])\n    IC_RATE = Q(P[\"IC_RATE\"])\n    D0 = Q(P[\"D0\"])\n    NIM = Q(P[\"NIM\"])\n    G = Q(P[\"G\"])\n    S = Q(P[\"S\"])\n    N = int(P[\"N\"])\n\n    interchange = SPEND * IC_RATE / 100\n    monthly_rate = NIM / 100 / 12\n\n    balance = D0  # beginning of month 1\n    cumulative = -CAC  # month 0\n    payback = 0\n    contrib_n = None\n    balance_begin_n = None\n\n    for t in range(1, N + 1):\n        balance_begin = balance\n        nii = balance_begin * monthly_rate\n        contrib = interchange + nii - S\n        cumulative += contrib\n        if payback == 0 and cumulative >= 0:\n            payback = t\n        if t == N:\n            contrib_n = contrib\n            balance_begin_n = balance_begin\n        # end-of-month deposit change, floored at zero\n        balance = balance_begin + G\n        if balance < 0:\n            balance = Q(0)\n\n    return {\n        \"final\": cumulative,\n        \"balance_begin_month_n\": balance_begin_n,\n        \"contribution_month_n\": contrib_n,\n        \"payback_month\": Q(payback),\n    }\n",
