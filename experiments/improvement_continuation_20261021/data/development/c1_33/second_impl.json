 "program": "def solve():\n    N = Fraction(P[\"N\"])\n    P0 = Fraction(P[\"P0\"])\n    PEX = Fraction(P[\"PEX\"])\n    D = Fraction(P[\"D\"])\n    P1 = Fraction(P[\"P1\"])\n    mode = P[\"MODE\"]\n\n    # Ledger: initial purchase\n    cost = N * P0\n    cash = Fraction(0)\n    shares = N\n\n    # Dividend paid\n    cash += shares * D\n\n    # Reinvest at ex-dividend price\n    if mode == \"fractional\":\n        bought = cash / PEX\n        cash -= bought * PEX\n    elif mode == \"whole\":\n        bought = Fraction(math.floor(cash / PEX))\n        cash -= bought * PEX\n    else:\n        raise ValueError(\"unknown MODE\")\n    shares += bought\n\n    # Ending value\n    ending_value = shares * P1 + cash\n\n    price_return = (P1 / P0 - 1) * 100\n    total_return = (ending_value / cost - 1) * 100\n    dividend_contrib = total_return - price_return\n\n    return {\n        \"final\": dividend_contrib,\n        \"shares_held_end\": shares,\n        \"price_return\": price_return,\n        \"total_return\": total_return,\n    }\n",
