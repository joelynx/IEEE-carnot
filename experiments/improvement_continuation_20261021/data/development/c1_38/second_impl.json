 "program": "def solve():\n    notional = Q(P[\"NOTIONAL\"])\n    eurusd = Q(P[\"EURUSD\"])\n    eurgbp_inv = Q(P[\"EURGBP_INV\"])\n    gbpusd_mid = Q(P[\"GBPUSD_MID\"])\n    spread_pips = Q(P[\"SPREAD_PIPS\"])\n    fee_bps = Q(P[\"FEE_BPS\"])\n    max_loops = int(P[\"MAX_LOOPS\"])\n    hurdle_bps = Q(P[\"HURDLE_BPS\"])\n\n    fee_keep = 1 - fee_bps / 10000\n    half_width = spread_pips * Q(\"0.0001\") / 2\n    gbp_bid = gbpusd_mid - half_width\n\n    implied_cross = eurusd * eurgbp_inv  # USD per GBP\n\n    def run_loop(usd_start):\n        # USD -> EUR\n        eur = usd_start / eurusd\n        eur = eur * fee_keep\n        # EUR -> GBP (inverse quote: EUR per GBP)\n        gbp = eur / eurgbp_inv\n        gbp = gbp * fee_keep\n        # GBP -> USD sold at bid\n        usd = gbp * gbp_bid\n        usd = usd * fee_keep\n        return usd\n\n    # single-loop profit on the original notional\n    usd_after_one = run_loop(notional)\n    single_profit_bps = (usd_after_one - notional) / notional * 10000\n\n    # ledger of loops\n    balance = notional\n    executed = 0\n    while executed < max_loops:\n        start = balance\n        balance = run_loop(start)\n        executed += 1\n        loop_profit_bps = (balance - start) / start * 10000\n        if loop_profit_bps < hurdle_bps:\n            break\n\n    cumulative_bps = (balance - notional) / notional * 10000\n\n    return {\n        \"final\": cumulative_bps,\n        \"implied_cross_rate\": implied_cross,\n        \"single_loop_profit_bps\": single_profit_bps,\n        \"ending_usd_balance\": balance,\n        \"loop_profitable\": \"profitable\" if single_profit_bps > 0 else \"unprofitable\",\n    }\n",
