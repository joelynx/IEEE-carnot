        "code": "def solve():\n    start = Q(550000)\n    eurusd = Q(\"1.1175\")\n    eur_per_gbp = Q(\"1.19\")\n    gbpusd_mid = Q(\"1.2625\")\n    half_spread = Q(13) * Q(\"0.0001\")\n    bid = gbpusd_mid - half_spread\n    fee = Q(\"0.00035\")\n\n    implied_cross = eurusd * eur_per_gbp  # USD per GBP\n\n    def run_loop(usd):\n        eur = usd / eurusd * (1 - fee)\n        gbp = eur / eur_per_gbp * (1 - fee)\n        usd_end = gbp * bid * (1 - fee)\n        return usd_end\n\n    single_end = run_loop(start)\n    single_bps = (single_end - start) / start * 10000\n\n    balance = start\n    for _ in range(2):\n        end = run_loop(balance)\n        profit_bps = (end - balance) / balance * 10000\n        balance = end\n        if profit_bps < 0:\n            break\n\n    cumulative_bps = (balance - start) / start * 10000\n\n    return {\n        \"final\": cumulative_bps,\n        \"implied_cross_rate\": implied_cross,\n        \"single_loop_profit_bps\": single_bps,\n        \"ending_usd_balance\": balance,\n        \"loop_profitable\": \"profitable\" if single_bps > 0 else \"unprofitable\",\n    }\n",
