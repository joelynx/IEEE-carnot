 "program": "def solve():\n    COST = Q(P[\"COST\"]); RESID = Q(P[\"RESID\"]); N0 = Q(P[\"N0\"])\n    E12 = Q(P[\"E12\"]); NREM = Q(P[\"NREM\"]); E3 = Q(P[\"E3\"])\n    DEV = Q(P[\"DEV\"]); E4 = Q(P[\"E4\"])\n\n    if N0 <= 0 or NREM <= 0:\n        raise ValueError(\"invalid reserve estimates\")\n\n    # Ledger-style state: capitalized cost, accumulated depletion\n    cap_cost = COST\n    acc = Q(0)\n\n    # Years 1 and 2: original rate\n    rate1 = (cap_cost - acc - RESID) / N0\n    for _ in range(2):\n        acc += E12 * rate1\n\n    # Start Year 3: re-estimate, new prospective rate\n    carrying_start3 = cap_cost - acc\n    rate3 = (carrying_start3 - RESID) / NREM\n    dep3 = E3 * rate3\n    acc += dep3\n\n    # End Year 3: capitalize development cost\n    cap_cost += DEV\n\n    # Start Year 4: reset rate\n    remaining4 = NREM - E3\n    if remaining4 <= 0:\n        raise ValueError(\"no remaining estimated units at start of Year 4\")\n    carrying_start4 = cap_cost - acc\n    rate4 = (carrying_start4 - RESID) / remaining4\n    units4 = E4 if E4 <= remaining4 else remaining4\n    dep4 = units4 * rate4\n    acc += dep4\n\n    carrying_end4 = cap_cost - acc\n\n    return {\n        \"final\": dep4,\n        \"year3_rate_per_unit\": rate3,\n        \"year3_depletion\": dep3,\n        \"accumulated_depletion_end_year4\": acc,\n        \"carrying_amount_end_year4\": carrying_end4,\n        \"year4_depletion\": dep4,\n    }\n",
