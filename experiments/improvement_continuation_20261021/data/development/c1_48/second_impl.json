 "program": "def solve():\n    open_bal = Q(P[\"OPEN_BAL\"])\n    m1 = int(P[\"M1_DAYS\"])\n    m2 = int(P[\"M2_DAYS\"])\n    promo = Q(P[\"PROMO_RATE\"]) / 100\n    std = Q(P[\"STD_RATE\"]) / 100\n    promo_days = int(P[\"PROMO_DAYS\"])\n    deposit = Q(P[\"DEPOSIT\"])\n    dep_day = int(P[\"DEP_DAY\"])\n\n    def rate_for(abs_day):\n        return promo if abs_day <= promo_days else std\n\n    # Month one: day-by-day ledger, interest accrued but not credited until month end\n    balance = open_bal\n    accrued1 = Q(0)\n    for d in range(1, m1 + 1):\n        accrued1 += balance * rate_for(d) / 365\n    interest_month_one = accrued1\n    balance += interest_month_one\n    balance_start_month_two = balance\n\n    # Month two\n    accrued2 = Q(0)\n    for d in range(1, m2 + 1):\n        if d == dep_day:\n            balance += deposit\n        abs_day = m1 + d\n        accrued2 += balance * rate_for(abs_day) / 365\n    interest_month_two = accrued2\n    balance += interest_month_two\n\n    return {\n        \"final\": balance,\n        \"interest_month_one\": interest_month_one,\n        \"balance_start_month_two\": balance_start_month_two,\n        \"interest_month_two\": interest_month_two,\n    }\n",
