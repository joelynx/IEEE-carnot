 "program": "def solve():\n    rev0 = Q(P[\"REVENUE_BN\"]) * 1000  # USD millions\n    cogs = Q(P[\"COGS_PCT\"]) / 100\n    opex = Q(P[\"OPEX_PCT\"]) / 100\n    imp = Q(P[\"IMPROVE_BP\"])\n    mode = P[\"MODE\"]\n    cap = Q(P[\"CAP_BP\"])\n    g = Q(P[\"GROWTH_PCT\"]) / 100\n    years = int(P[\"YEARS\"])\n\n    base_margin = 1 - cogs - opex\n    current_oi = rev0 * base_margin\n\n    # explicit year-by-year ledger\n    rev = rev0\n    cum_oi = Q(0)\n    gain_t = Q(0)\n    margin_t = base_margin\n    oi_t = Q(0)\n    for t in range(1, years + 1):\n        rev = rev * (1 + g)\n        if mode == \"once\":\n            raw = imp\n        else:\n            raw = imp * t\n        gain_t = raw if raw < cap else cap\n        margin_t = base_margin + gain_t / 10000\n        oi_t = rev * margin_t\n        cum_oi += oi_t\n\n    increase = oi_t - current_oi\n\n    return {\n        \"final\": increase,\n        \"current_operating_income\": current_oi,\n        \"final_year_gain_bp\": gain_t,\n        \"final_year_margin_pct\": margin_t * 100,\n        \"cumulative_operating_income\": cum_oi,\n    }\n",
