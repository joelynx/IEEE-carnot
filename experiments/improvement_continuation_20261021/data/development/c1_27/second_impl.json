 "program": "def solve():\n    N = P[\"N\"]\n    C = P[\"C\"]\n    R = P[\"R\"]\n    D = P[\"D\"]\n    c_cents = Q(P[\"C_CENTS\"])\n    S = P[\"S\"]\n\n    # Walk day by day, tracking when the current key started.\n    key_start = 1\n    for day in range(1, C + 1):\n        if day > 1 and (day - 1) % N == 0:\n            # rotation happened at end of previous day; new key covers from this day\n            key_start = day\n    # exposure window: key_start .. C inclusive\n    exposure_days = C - key_start + 1\n\n    # ledger of records per day\n    exposed = 0\n    for day in range(key_start, C + 1):\n        records_today = R + (day - 1) * D\n        exposed += records_today\n\n    base_cost_usd = Q(exposed) * c_cents / Q(100)\n    adjustment = base_cost_usd * Q(S) / Q(10000)\n    total = base_cost_usd + adjustment\n\n    return {\n        \"final\": total,\n        \"exposure_days\": Q(exposure_days),\n        \"exposed_records\": Q(exposed),\n        \"base_cost_usd\": base_cost_usd,\n    }\n",
